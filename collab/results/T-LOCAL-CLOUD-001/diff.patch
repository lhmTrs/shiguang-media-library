+test("证书失败：CA 不匹配或客户端证书不受信都必须失败", async (t) => {
+  const { auth, cloud } = await setup(t);
+  // 客户端信任错误的 CA → 校验服务端证书失败
+  await auth.configure({ origin: cloud.origin, caPath: cloud.otherCaCert, certPath: cloud.clientCertA, keyPath: cloud.clientKeyA });
+  await assert.rejects(
+    () => auth.login({ username: "alice", password: PASSWORD }),
+    (e) => e instanceof CloudAuthError && e.kind === "cert",
+  );
+  // 客户端证书由不受信 CA 签发 → 服务端拒绝握手
+  await auth.configure({ origin: cloud.origin, caPath: cloud.caCert, certPath: cloud.clientUntrustedCert, keyPath: cloud.clientUntrustedKey });
+  await assert.rejects(
+    () => auth.login({ username: "alice", password: PASSWORD }),
+    (e) => e instanceof CloudAuthError && (e.kind === "cert" || e.kind === "network"),
+  );
+  assert.notEqual(auth.getState().state, "logged-in");
+});
+
+test("账户切换：换设备证书后不复用前一个账户的凭据", async (t) => {
+  const { auth, configure, cloud, lib } = await setup(t);
+  await configure();
+  await auth.login({ username: "alice", password: PASSWORD });
+  assert.equal((await auth.me()).username, "alice");
+
+  await configure({ certPath: cloud.clientCertB, keyPath: cloud.clientKeyB });
+  assert.equal(auth.getState().state, "logged-out", "换证书应清空旧会话");
+  assert.equal(lib.db.prepare("SELECT encrypted FROM app_secrets WHERE id='cloud.refreshToken'").get(), undefined);
+  const state = await auth.login({ username: "bob", password: PASSWORD });
+  assert.equal(state.username, "bob");
+  assert.equal((await auth.me()).username, "bob");
+  assert.equal(cloud.counts.login, 2);
+});
+
+function lib_dir(auth) {
+  return auth.dataDir;
+}
