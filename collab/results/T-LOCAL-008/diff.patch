+    state: s(v?.state),
+    version: n(v?.version),
+  };
+}
+
+function sanitizeMember(v) {
+  return { accountId: s(v?.accountId), state: s(v?.state) };
+}
+
+function sanitizeProfile(v) {
+  return {
+    accountId: s(v?.accountId),
+    username: s(v?.username),
