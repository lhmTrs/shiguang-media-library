+import type { LocalRequest } from "./OpenAISettings";
+
+/**
+ * T-LOCAL-008：账户 / 小组 / 授权管理工作区。
+ *
+ * - 浏览器只提交业务参数；方法、云端路径、mTLS/Bearer 全由本地 Node 固定。
+ * - 一次性开通码/重置码只在当前组件内存展示，支持点击复制，绝不写 localStorage、
