+  const limit = query.limit === undefined ? 50 : integer(Number(query.limit), { min: 1, max: MAX_PAGE, name: "limit" });
+  const offset = query.offset === undefined ? 0 : integer(Number(query.offset), { min: 0, name: "offset" });
+  return { limit, offset };
