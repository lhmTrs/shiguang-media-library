+  const config = await fetch(`${server.url}/api/cloud-auth/config`, {
+    method: "POST",
+    headers,
+    body: JSON.stringify({
+      origin: cloud.origin,
+      caPath: cloud.caCert,
+      certPath: cert.cert,
