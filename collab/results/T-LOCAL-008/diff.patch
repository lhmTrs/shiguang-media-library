+
+function bool(value, name = "字段") {
+  if (typeof value !== "boolean") invalid(`${name}必须是布尔值`);
+  return value;
+}
+
+function id(value, name = "ID") {
+  if (typeof value !== "string" || !ID_RE.test(value)) invalid(`${name}不合法`);
+  return value;
+}
+
