+test("spawn ENOENT/EACCES：受控 spawn-error，等 close 并清理租约/任务目录，不死宿主", async (t) => {
+  const { root, dataDir, executor } = await setup(t);
+  const missing = path.join(root, "missing-command");
+  const notExecutable = path.join(root, "not-executable");
+  await fs.writeFile(notExecutable, "#!/bin/sh\nexit 0\n", { mode: 0o644 });
+  await fs.chmod(notExecutable, 0o644);
+
+  for (const command of [missing, notExecutable]) {
+    const result = await executor.run({ command, timeoutMs: 300 });
+    assert.equal(result.state, "spawn-error", JSON.stringify(result));
+    assert.equal(result.groupReaped, true);
+    assert.equal(fssync.existsSync(path.join(dataDir, ".audio-executor.lock")), false, "失败后租约必须释放");
+    const jobsRoot = path.join(dataDir, "executor-jobs");
+    assert.equal(
+      fssync.existsSync(jobsRoot) ? fssync.readdirSync(jobsRoot).length : 0,
+      0,
+      "失败后任务临时目录必须清理",
+    );
+  }
+
+  // 失败不得污染同进程的下一任务。
+  const next = await executor.run(baseRun("success"));
+  assert.equal(next.state, "success", JSON.stringify(next));
+});
+
+test("onSpawn 回调异常：受控 SPAWN_CALLBACK_FAILED，等 close、清理租约，下一任务可执行", async (t) => {
+  const { dataDir, executor } = await setup(t);
+  await assert.rejects(
+    () => executor.run(baseRun("success", {
+      onSpawn: () => {
+        throw new Error("synthetic onSpawn failure");
+      },
+    })),
+    (error) => error instanceof ExecutorError && error.code === "SPAWN_CALLBACK_FAILED",
+  );
+  assert.equal(fssync.existsSync(path.join(dataDir, ".audio-executor.lock")), false, "回调异常后租约必须释放");
+  const jobsRoot = path.join(dataDir, "executor-jobs");
+  assert.equal(
+    fssync.existsSync(jobsRoot) ? fssync.readdirSync(jobsRoot).length : 0,
+    0,
+    "回调异常后任务临时目录必须清理",
+  );
+
+  const next = await executor.run(baseRun("success"));
+  assert.equal(next.state, "success", JSON.stringify(next));
+});
