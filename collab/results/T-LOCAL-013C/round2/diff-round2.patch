+test("callback 错误边界只保留允许列表固定码与默认文案，不泄露 message/status/路径", async (t) => {
+  const archive = await makeTar([{ name: "audio-analyze", data: BINARY }]);
+  const { dataDir, engine } = await setup(t, archive);
+  await installOk(engine);
+
+  const typed = new AudioEngineError("ENGINE_RUN_FAILED", "/private/synthetic/secret.wav", 418);
+  assert.equal(typed.message, "/private/synthetic/secret.wav", "旧错误构造器对外兼容");
+  assert.equal(typed.status, 418);
+
+  const cases = [
+    { name: "typed private path", thrower: () => { throw new AudioEngineError("ENGINE_RUN_FAILED", "/private/synthetic/secret.wav", 500); }, code: "ENGINE_RUN_FAILED" },
+    { name: "typed unknown code", thrower: async () => { throw new AudioEngineError("INTERNAL_SECRET_CODE", "/private/synthetic/secret.wav", 500); }, code: "ENGINE_RUN_FAILED" },
+    { name: "typed cancelled", thrower: () => { throw new AudioEngineError("ENGINE_CANCELLED", "/private/synthetic/secret.wav"); }, code: "ENGINE_CANCELLED" },
+    { name: "ordinary error", thrower: async () => { throw new Error("secret callback detail /private/synthetic/secret.wav"); }, code: "ENGINE_RUN_FAILED" },
+    { name: "non-error throw", thrower: () => { throw "secret string /private/synthetic/secret.wav"; }, code: "ENGINE_RUN_FAILED" },
+  ];
+  for (const item of cases) {
+    let caught = null;
+    try {
+      await engine.withRunLease(async () => item.thrower());
+    } catch (error) {
+      caught = error;
+    }
+    assert.equal(caught?.code, item.code, item.name);
+    assert.equal(caught?.message.includes("/private/"), false, `${item.name} 不得泄露路径`);
+    assert.equal(caught?.message.includes("secret"), false, `${item.name} 不得泄露原始文案`);
+    assert.equal(caught?.status, 400, `${item.name} 必须使用默认 status`);
+    assert.equal(caught?.message, item.code === "ENGINE_CANCELLED" ? "安装已取消" : "音频运行失败", item.name);
+    assertLockReleased(dataDir);
+    await engine.withRunLease(async () => {});
+    assertLockReleased(dataDir);
+  }
+});
