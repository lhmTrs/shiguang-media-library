+test("打开前同内容换 inode、同尺寸原位改写、换 FIFO 都在 callback 前受控拒绝", async (t) => {
+  const archive = await makeTar([{ name: "audio-analyze", data: BINARY }]);
+  const { root, dataDir, engine } = await setup(t, archive);
+  await installOk(engine);
+  const paths = await installPaths(dataDir);
+  const open = fs.open;
+  t.after(() => {
+    fs.open = open;
+  });
+
+  // 1) #loadRunRecord 的 lstat 与真正的 open 之间，用 rename + 同内容新 inode 替换。
+  let swapped = false;
+  fs.open = async (file, ...args) => {
+    if (!swapped && file === paths.binary) {
+      swapped = true;
+      await fs.rename(paths.binary, paths.binary + ".old");
+      await fs.writeFile(paths.binary, BINARY, { mode: 0o755 });
+    }
+    return open(file, ...args);
+  };
+  let called = false;
+  await assert.rejects(
+    engine.withRunLease(async () => {
+      called = true;
+    }),
+    (error) => error.code === "ENGINE_INTEGRITY_FAILED",
+  );
+  assert.equal(swapped, true);
+  assert.equal(called, false, "同内容换 inode 后不得调用 callback");
+  assertLockReleased(dataDir);
+  fs.open = open;
+  await fs.rm(paths.binary + ".old", { force: true });
+  await engine.withRunLease(async () => {});
+  assertLockReleased(dataDir);
+
+  // 2) 同尺寸原位改写（内容仍是同一份字节，只有 mtime/ctime 变化）也必须拒绝。
+  let rewritten = false;
+  fs.open = async (file, ...args) => {
+    if (!rewritten && file === paths.binary) {
+      rewritten = true;
+      await delay(5);
+      fssync.writeFileSync(paths.binary, BINARY, { mode: 0o755 });
+    }
+    return open(file, ...args);
+  };
+  called = false;
+  await assert.rejects(
+    engine.withRunLease(async () => {
+      called = true;
+    }),
+    (error) => error.code === "ENGINE_INTEGRITY_FAILED",
+  );
+  assert.equal(rewritten, true);
+  assert.equal(called, false, "原位改写后不得调用 callback");
+  assertLockReleased(dataDir);
+  fs.open = open;
+  await engine.withRunLease(async () => {});
+  assertLockReleased(dataDir);
+
+  // 3) open 前把路径换成 FIFO：O_NONBLOCK 不挂起，fstat 非普通文件必须拒绝。
+  const savedBinary = path.join(root, "saved-before-open");
+  let fifo = false;
+  fs.open = async (file, ...args) => {
+    if (!fifo && file === paths.binary) {
+      fifo = true;
+      await fs.rename(paths.binary, savedBinary);
+      await execFileAsync("mkfifo", [paths.binary]);
+    }
+    return open(file, ...args);
+  };
+  called = false;
+  await assert.rejects(
+    engine.withRunLease(async () => {
+      called = true;
+    }),
+    (error) => error.code === "ENGINE_INTEGRITY_FAILED",
+  );
+  assert.equal(fifo, true);
+  assert.equal(called, false, "路径换 FIFO 后不得调用 callback");
+  assertLockReleased(dataDir);
+  fs.open = open;
+  await fs.rm(paths.binary);
+  await fs.rename(savedBinary, paths.binary);
+  await engine.withRunLease(async () => {});
+  assertLockReleased(dataDir);
+});
