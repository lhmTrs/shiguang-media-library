+      options.pfx = await read(cfg.p12Path, "设备 P12 证书");
+      options.passphrase = passphrase;
+    } else {
+      options.cert = await read(cfg.certPath, "设备证书");
+      options.key = await read(cfg.keyPath, "设备私钥");
+    }
+    return options;
+  }
+
+  async #applySession(data, epoch) {
+    if (epoch !== this.epoch) throw this.#staleError();
+    if (!data || typeof data.accessToken !== "string" || typeof data.refreshToken !== "string")
+      throw new CloudAuthError("云端认证响应缺少令牌字段", { kind: "cloud" });
+    const expiresIn = Number(data.expiresIn);
+    if (!Number.isFinite(expiresIn) || expiresIn <= 0)
+      throw new CloudAuthError("云端认证响应缺少有效的 expiresIn", { kind: "cloud" });
+    // 原子替换刷新令牌（SecretStore.set 内部事务 + 回读校验）
+    await this.secrets.set(REFRESH_SECRET, data.refreshToken);
+    if (epoch !== this.epoch) {
+      // 迟到响应不能把旧凭据写进新上下文；只删除仍属于本次响应的值
+      if (this.secrets.get(REFRESH_SECRET) === data.refreshToken) this.secrets.remove(REFRESH_SECRET);
+      throw this.#staleError();
+    }
+    this.accessToken = data.accessToken;
+    this.accessExpiresAt = this.clock() + expiresIn * 1000;
+    this.state = {
+      ...this.state,
+      refreshing: false,
+      state: "logged-in",
+      lastError: null,
+      retryAt: 0,
+      retryAfterMs: 0,
+      accessExpiresAt: nowIso(this.accessExpiresAt),
+      refreshExpiresAt: data.refreshExpiresAt || this.state.refreshExpiresAt || null,
+    };
+    await this.#persistState();
+  }
+
+  async #refreshProfile(epoch) {
+    const profile = await this.me();
+    if (epoch !== this.epoch) throw this.#staleError();
+    this.state = {
+      ...this.state,
+      username: profile?.username || this.state.username || null,
+      displayName: profile?.displayName || null,
+      accountId: profile?.accountId || null,
+      deviceId: profile?.deviceId || null,
+      sessionId: profile?.sessionId || null,
+      superAdmin: profile?.superAdmin === true,
+      state: "logged-in",
+    };
+    await this.#persistState();
+  }
+
+  async #clear(stateName, publicError = null, epoch = null) {
+    if (epoch !== null && epoch !== this.epoch) throw this.#staleError();
+    this.#invalidate();
+    this.secrets.remove(REFRESH_SECRET);
+    this.accessToken = null;
+    this.accessExpiresAt = 0;
+    this.state = {
+      ...this.state,
+      state: stateName,
+      refreshing: false,
+      username: null,
+      displayName: null,
+      accountId: null,
+      deviceId: null,
+      sessionId: null,
+      superAdmin: false,
+      lastError: publicError || null,
+      retryAt: 0,
+      retryAfterMs: 0,
+    };
+    await this.#persistState();
+  }
+
+  async #patchState(patch, epoch = null) {
+    if (epoch !== null && epoch !== this.epoch) throw this.#staleError();
+    this.state = { ...this.state, ...patch };
+    await this.#persistState();
+  }
+
+  #persistState() {
+    const write = async () => {
+      const out = { ...this.state };
+      delete out._;
+      await this.#writeJson(this.statePath, out);
+    };
+    this.persistChain = this.persistChain.then(write, write);
+    return this.persistChain;
+  }
+
+  async #readJson(file) {
+    try {
+      return JSON.parse(await fs.readFile(file, "utf8"));
+    } catch (e) {
+      if (e.code === "ENOENT") return null;
+      throw new CloudAuthError("本地云端配置文件无法读取", { kind: "config", code: "STORAGE_ERROR", cause: e });
+    }
+  }
+
+  async #writeJson(file, value) {
+    const dir = path.dirname(file);
+    const tmp = `${file}.tmp-${process.pid}-${Math.random().toString(16).slice(2, 8)}`;
+    try {
+      await fs.mkdir(dir, { recursive: true });
+      const handle = await fs.open(tmp, "w", 0o600);
+      try {
+        await handle.writeFile(JSON.stringify(value, null, 2), "utf8");
+        await handle.sync();
+      } finally {
+        await handle.close();
+      }
+      await fs.chmod(tmp, 0o600);
+      await fs.rename(tmp, file);
+    } catch (e) {
+      await fs.rm(tmp, { force: true }).catch(() => {});
+      throw new CloudAuthError("本地云端配置保存失败", { kind: "config", code: "STORAGE_ERROR", cause: e });
+    }
+  }
+}
+
+/** 云端认证路由的末端错误边界：所有异常都收敛为固定公开码，绝不透传原始 message/本机路径 */
+export function cloudAuthErrorHandler(error, req, res, next) {
+  if (res.headersSent) return next(error);
+  const isCloud = error instanceof CloudAuthError;
+  const pub = isCloud
+    ? error.toPublic()
+    : { code: "INTERNAL", kind: "internal", status: null, requestId: null, retryAfterMs: 0, message: PUBLIC_MESSAGES.internal };
+  if (!isCloud) console.error("[cloud-auth] INTERNAL");
+  else if (pub.status !== 401 && pub.status !== 429) console.error(`[cloud-auth] ${pub.code}`);
+  const status = [400, 401, 403, 404, 409, 413, 429, 503].includes(pub.status) ? pub.status : 400;
+  if (pub.retryAfterMs > 0) res.setHeader("Retry-After", String(Math.max(1, Math.ceil(pub.retryAfterMs / 1000))));
+  res.status(status).json({
+    error: pub.message,
+    code: pub.code,
+    kind: pub.kind,
+    ...(pub.retryAfterMs > 0 ? { retryAfterMs: pub.retryAfterMs } : {}),
+    ...(pub.requestId ? { requestId: pub.requestId } : {}),
+  });
+}
+
+function safeCode(value) {
+  const code = typeof value === "string" ? value : String(value || "");
+  return /^[A-Za-z0-9_]{1,64}$/.test(code) ? code : "UNKNOWN";
+}
+
+function safeRequestId(value) {
+  const id = typeof value === "string" ? value : "";
+  return /^[A-Za-z0-9._:-]{1,64}$/.test(id) ? id : null;
+}
+
+function safeHost(origin) {
+  try {
+    return new URL(origin).host;
+  } catch {
+    return null;
+  }
+}
diff --git a/server/cloud-release-config.mjs b/server/cloud-release-config.mjs
new file mode 100644
index 0000000..a8d12a5
--- /dev/null
+++ b/server/cloud-release-config.mjs
@@ -0,0 +1,150 @@
+/**
+ * T-LOCAL-007：内置「发行版云端连接」配置。
+ *
+ * 只保存公共信息：两个 HTTPS origin 与两张公开 CA 证书（serverCaPem 验证云端
+ * HTTPS，deviceCaPem 验证签发的设备证书）。绝不包含 PRIVATE KEY、口令、个人
+ * 设备证书或运行时路径。
+ *
+ * 原始仓库默认 enabled=false、地址/证书为空；正式值由部署方在打包前用
+ * scripts/cloud-release-config.mjs 生成，不能靠硬编码或从失败配置回退。
+ */
+import crypto from "node:crypto";
+import fs from "node:fs/promises";
+
+export const RELEASE_CONFIG_SCHEMA = 1;
+export const MAX_RELEASE_CONFIG_BYTES = 256 * 1024;
+export const DEFAULT_RELEASE_CONFIG = Object.freeze({
+  schemaVersion: RELEASE_CONFIG_SCHEMA,
+  enabled: false,
+  apiOrigin: "",
+  enrollmentOrigin: "",
+  serverCaPem: "",
+  deviceCaPem: "",
+});
+
+const ORIGIN_KEYS = ["apiOrigin", "enrollmentOrigin"];
+
+/** 只接受 https://host[:port]，禁止用户信息、路径、查询、hash */
+export function parseOrigin(value, label) {
+  if (typeof value !== "string" || !value.trim()) throw new Error(`${label} 不能为空`);
+  let url;
+  try {
+    url = new URL(value.trim());
+  } catch {
+    throw new Error(`${label} 不是合法 URL`);
+  }
+  if (url.protocol !== "https:") throw new Error(`${label} 必须使用 https://`);
+  if (url.username || url.password) throw new Error(`${label} 不能包含用户信息`);
+  if (url.pathname !== "/" || url.search || url.hash)
+    throw new Error(`${label} 只能包含协议、主机和端口，不能带路径、查询或 hash`);
+  if (!url.hostname) throw new Error(`${label} 缺少主机名`);
+  return `${url.protocol}//${url.host}`;
+}
+
+/** 从 PEM 文本里取全部 CERTIFICATE 块；任何 PRIVATE KEY 都直接拒绝 */
+export function parsePublicCertificates(pem, label) {
+  if (typeof pem !== "string" || !pem.trim()) throw new Error(`${label} 不能为空`);
+  if (/-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----/.test(pem)) throw new Error(`${label} 不能包含私钥`);
+  const blocks = [...pem.matchAll(/-----BEGIN CERTIFICATE-----[\s\S]*?-----END CERTIFICATE-----/g)].map((m) => m[0]);
+  if (!blocks.length) throw new Error(`${label} 不是 PEM 证书`);
+  let certificates;
+  try {
+    certificates = blocks.map((block) => new crypto.X509Certificate(block));
+  } catch {
+    throw new Error(`${label} 含无法解析的证书`);
+  }
+  return { pem: blocks.join("\n") + "\n", certificates };
+}
+
+function looksLikePrivateMaterial(value) {
+  return typeof value === "string" && /-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----/.test(value);
+}
+
+/**
+ * 校验发行配置。返回 { config, errors, warnings, usable }，不抛异常，
+ * 让启动路径在配置坏掉时安全地保持「未就绪」，而不是崩溃或回退到假地址。
+ */
+export function validateReleaseConfig(raw) {
+  const errors = [];
+  const warnings = [];
+  const config = { ...DEFAULT_RELEASE_CONFIG };
+  if (!raw || typeof raw !== "object" || Array.isArray(raw)) {
+    return { config, errors: ["发行配置必须是 JSON 对象"], warnings, usable: false };
+  }
+  if (raw.schemaVersion !== RELEASE_CONFIG_SCHEMA) errors.push(`schemaVersion 必须为 ${RELEASE_CONFIG_SCHEMA}`);
+  config.schemaVersion = RELEASE_CONFIG_SCHEMA;
+  if (typeof raw.enabled !== "boolean") errors.push("enabled 必须是布尔值");
+  config.enabled = raw.enabled === true;
+
+  for (const key of ["apiOrigin", "enrollmentOrigin", "serverCaPem", "deviceCaPem"]) {
+    const value = raw[key];
+    if (value !== undefined && typeof value !== "string") errors.push(`${key} 必须是字符串`);
+    config[key] = typeof value === "string" ? value : "";
+    if (looksLikePrivateMaterial(value)) errors.push(`${key} 不能包含私钥`);
+  }
+  const allowed = new Set(["schemaVersion", "enabled", ...ORIGIN_KEYS, "serverCaPem", "deviceCaPem"]);
+  for (const key of Object.keys(raw)) if (!allowed.has(key)) warnings.push(`忽略未知字段 ${key}`);
+
+  if (config.enabled) {
+    for (const key of ORIGIN_KEYS) {
+      try {
+        config[key] = parseOrigin(config[key], key);
+      } catch (e) {
+        errors.push(e.message);
+      }
+    }
+    for (const key of ["serverCaPem", "deviceCaPem"]) {
+      try {
+        config[key] = parsePublicCertificates(config[key], key).pem;
+      } catch (e) {
+        errors.push(e.message);
+      }
+    }
+    if (errors.length === 0) {
+      for (const [key, label] of [
+        ["serverCaPem", "serverCaPem"],
+        ["deviceCaPem", "deviceCaPem"],
+      ]) {
+        const certs = parsePublicCertificates(config[key], label).certificates;
+        if (!certs.some((cert) => cert.ca === true)) errors.push(`${label} 必须包含 CA 证书`);
+      }
+    }
+  } else {
+    // 未启用时也要拒绝私钥，避免有人把私钥塞进打包文件。
+    for (const key of ["serverCaPem", "deviceCaPem"]) {
+      if (config[key]) {
+        try {
+          config[key] = parsePublicCertificates(config[key], key).pem;
+        } catch (e) {
+          errors.push(e.message);
+        }
+      }
+    }
+  }
+  return { config, errors, warnings, usable: errors.length === 0 && config.enabled && Boolean(config.apiOrigin && config.enrollmentOrigin) };
+}
+
+/** 读取项目内的发行配置；文件不存在（原始仓库默认）按未启用处理，绝不创建文件。 */
+export async function loadReleaseConfig(file) {
+  let text;
+  try {
+    const stat = await fs.stat(file);
+    if (!stat.isFile()) return { ...DEFAULT_RELEASE_CONFIG, usable: false, errors: ["发行配置不是普通文件"], warnings: [] };
+    if (stat.size > MAX_RELEASE_CONFIG_BYTES)
+      return { ...DEFAULT_RELEASE_CONFIG, usable: false, errors: ["发行配置过大"], warnings: [] };
+    text = await fs.readFile(file, "utf8");
+  } catch (e) {
+    if (e.code === "ENOENT") return { ...DEFAULT_RELEASE_CONFIG, usable: false, errors: [], warnings: [], missing: true };
+    return { ...DEFAULT_RELEASE_CONFIG, usable: false, errors: ["发行配置无法读取"], warnings: [] };
+  }
+  if (/-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----/.test(text))
+    return { ...DEFAULT_RELEASE_CONFIG, usable: false, errors: ["发行配置不能包含私钥"], warnings: [] };
+  let raw;
+  try {
+    raw = JSON.parse(text);
+  } catch {
+    return { ...DEFAULT_RELEASE_CONFIG, usable: false, errors: ["发行配置不是合法 JSON"], warnings: [] };
+  }
+  const checked = validateReleaseConfig(raw);
+  return { ...checked.config, usable: checked.usable, errors: checked.errors, warnings: checked.warnings };
+}
diff --git a/server/device-enrollment.mjs b/server/device-enrollment.mjs
new file mode 100644
index 0000000..1da24a0
--- /dev/null
+++ b/server/device-enrollment.mjs
@@ -0,0 +1,572 @@
+/**
+ * T-LOCAL-007：本机设备自动开通（device enrollment v1）。
+ *
+ * 安全边界：
+ *   - 私钥只在本机后端数据目录（目录 0700、文件 0600），不发给云端之外的任何一方，
+ *     更不返回浏览器；浏览器只提交开通码/密码并拿到脱敏状态。
+ *   - 兑换只走 HTTPS，使用发行配置里的 serverCaPem 校验 CA 与主机名；不跟随重定向、
+ *     不关闭证书校验、不携带任何令牌/客户端证书。
+ *   - 返回的设备证书必须先匹配本机私钥、clientAuth/非 CA/有效期，并链到预置
+ *     deviceCaPem，才原子落盘；异常响应绝不覆盖已正常使用的设备配置。
+ *   - single-flight；原码响应丢失时复用原私钥与设备名；开通码只存 SHA-256。
+ *   - 与 CloudAuth 共用代次：退出/切换账户后，迟到的开通响应不能复活旧配置。
+ */
+import crypto from "node:crypto";
+import fs from "node:fs/promises";
+import https from "node:https";
+import net from "node:net";
+import path from "node:path";
+import { CloudAuthError, parseRetryAfterMs } from "./cloud-auth.mjs";
+
+const SCHEMA_VERSION = 1;
+const DEVICE_DIR = "cloud-device";
+const PENDING_FILE = "pending-enrollment.json";
+const METADATA_FILE = "device.json";
+const KEY_FILE = "device-key.pem";
+const CERT_FILE = "device-cert.pem";
+const SERVER_CA_FILE = "server-ca.pem";
+const CLIENT_AUTH_EKU = "1.3.6.1.5.5.7.3.2";
+const MAX_REQUEST_BYTES = 16 * 1024;
+const MAX_RESPONSE_BYTES = 128 * 1024;
+const MAX_CERT_DAYS = 90;
+const MAX_CERT_MS = (MAX_CERT_DAYS + 1) * 24 * 60 * 60 * 1000;
+/** 允许签发端与本机的少量时钟偏差；过期仍严格按本机时间判断。 */
+const CERT_CLOCK_SKEW_MS = 5 * 60 * 1000;
+const MIN_RETRY_AFTER_MS = 1_000;
+const MAX_RETRY_AFTER_MS = 24 * 60 * 60 * 1000;
+
+const fail = (code, message, { kind = "cloud", status = null, retryAfterMs = 0, cause = null } = {}) =>
+  new CloudAuthError(message, { kind, code, status, retryAfterMs, cause, cloudMessage: true });
+
+const isControl = (value) => /[\u0000-\u001f\u007f]/.test(value);
+
+function normalizeDeviceName(value) {
+  const name = typeof value === "string" ? value.trim() : "";
+  if (!name) return "本机";
+  if (name.length > 128 || isControl(name)) return null;
+  return name;
+}
+
+function normalizeOpeningCode(value) {
+  if (typeof value !== "string") return null;
+  const code = value.trim();
+  // 云端是 43 位 Base64URL；宽松到 16–256 位，兼容测试与后续长度，但不接受空白/控制符。
+  if (code.length < 16 || code.length > 256 || /\s/.test(code) || isControl(code)) return null;
+  return code;
+}
+
+function publicKeyHashOf(privateKey) {
+  const der = crypto.createPublicKey(privateKey).export({ type: "spki", format: "der" });
+  return crypto.createHash("sha256").update(der).digest("hex");
+}
+
+function canonicalEnrollmentText({ openingCode, publicKeyHash, deviceName }) {
+  return `shiguang-device-enrollment-v1\n${openingCode}\n${publicKeyHash}\n${deviceName}`;
+}
+
+/** 把 PEM 里的证书按出现顺序解析；只接受 CERTIFICATE，拒绝私钥。 */
+export function parseCertificateChain(pem, label = "certificateChainPem") {
+  if (typeof pem !== "string" || /-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----/.test(pem))
+    throw fail("CERT_CHAIN_INVALID", "设备证书链无效");
+  const blocks = [...pem.matchAll(/-----BEGIN CERTIFICATE-----[\s\S]*?-----END CERTIFICATE-----/g)].map((m) => m[0]);
+  if (!blocks.length) throw fail("CERT_CHAIN_INVALID", "设备证书链无效");
+  try {
+    return { pem: blocks.join("\n") + "\n", certificates: blocks.map((block) => new crypto.X509Certificate(block)) };
+  } catch {
+    throw fail("CERT_CHAIN_INVALID", "设备证书链无效");
+  }
+}
+
+/**
+ * 验证云端返回的设备证书。任何一项不满足都拒绝落盘。
+ * @returns {{chainPem:string, leaf:crypto.X509Certificate, expiresAt:string}}
+ */
+export function verifyEnrolledCertificate({ chainPem, privateKey, deviceCaPem, now = Date.now() }) {
+  const chain = parseCertificateChain(chainPem);
+  const leaf = chain.certificates[0];
+  const keyPublic = crypto.createPublicKey(privateKey);
+  const keyDer = keyPublic.export({ type: "spki", format: "der" });
+  let leafDer;
+  try {
+    leafDer = leaf.publicKey.export({ type: "spki", format: "der" });
+  } catch {
+    throw fail("CERT_KEY_MISMATCH", "设备证书与本机密钥不匹配");
+  }
+  if (!leafDer.equals(keyDer)) throw fail("CERT_KEY_MISMATCH", "设备证书与本机密钥不匹配");
+  try {
+    if (!leaf.checkPrivateKey(privateKey)) throw new Error("private key mismatch");
+  } catch {
+    throw fail("CERT_KEY_MISMATCH", "设备证书与本机密钥不匹配");
+  }
+
+  const from = Date.parse(leaf.validFrom);
+  const to = Date.parse(leaf.validTo);
+  if (!Number.isFinite(from) || !Number.isFinite(to) || from > now + CERT_CLOCK_SKEW_MS || to <= now)
+    throw fail("CERT_EXPIRED", "设备证书不在有效期内");
+  if (to - now > MAX_CERT_MS) throw fail("CERT_EXPIRED", "设备证书有效期超过允许范围");
+  if (leaf.ca === true) throw fail("CERT_CHAIN_INVALID", "设备证书不能是 CA 证书");
+
+  const usage = leaf.toLegacyObject()?.ext_key_usage;
+  if (!Array.isArray(usage) || !usage.includes(CLIENT_AUTH_EKU))
+    throw fail("CERT_CHAIN_INVALID", "设备证书用途不是 clientAuth");
+  if (Array.isArray(usage) && usage.includes("1.3.6.1.5.5.7.3.1"))
+    throw fail("CERT_CHAIN_INVALID", "设备证书不能用于 serverAuth");
+
+  // 逐级校验签名；链顺序必须是 叶 → 中间 → … → 根。
+  for (let i = 1; i < chain.certificates.length; i += 1) {
+    const child = chain.certificates[i - 1];
+    const issuer = chain.certificates[i];
+    let ok = false;
+    try {
+      ok = child.checkIssued(issuer) && child.verify(issuer.publicKey);
+    } catch {
+      ok = false;
+    }
+    if (!ok) throw fail("CERT_CHAIN_INVALID", "设备证书链签名无效");
+  }
+
+  const trusted = parseCertificateChain(deviceCaPem, "deviceCaPem").certificates;
+  const last = chain.certificates[chain.certificates.length - 1];
+  const anchored = trusted.some((root) => {
+    if (last.fingerprint256 === root.fingerprint256) return true;
+    try {
+      return last.checkIssued(root) && last.verify(root.publicKey);
+    } catch {
+      return false;
+    }
+  });
+  if (!anchored) throw fail("CERT_CHAIN_INVALID", "设备证书不是预置设备 CA 签发");
+
+  return { chainPem: chain.pem, leaf, expiresAt: new Date(to).toISOString() };
+}
+
+export class DeviceEnrollment {
+  constructor(lib, { dataDir, cloudAuth, release, clock = () => Date.now(), timeoutMs = 15_000 } = {}) {
+    this.lib = lib;
+    this.dataDir = dataDir || lib.dataDir;
+    this.cloudAuth = cloudAuth;
+    this.release = release || {};
+    this.clock = clock;
+    this.timeoutMs = timeoutMs;
+    this.deviceDir = path.join(this.dataDir, DEVICE_DIR);
+    this.pendingPath = path.join(this.deviceDir, PENDING_FILE);
+    this.metadataPath = path.join(this.deviceDir, METADATA_FILE);
+    this.keyPath = path.join(this.deviceDir, KEY_FILE);
+    this.certPath = path.join(this.deviceDir, CERT_FILE);
+    this.serverCaPath = path.join(this.deviceDir, SERVER_CA_FILE);
+    this.inflight = null;
+    this.cancelToken = null;
+    this.metadata = null;
+  }
+
+  async init() {
+    try {
+      this.metadata = JSON.parse(await fs.readFile(this.metadataPath, "utf8"));
+    } catch (e) {
+      if (e.code !== "ENOENT") this.metadata = null;
+    }
+    return this;
+  }
+
+  /** 浏览器可读：只有脱敏状态，没有路径、码、密钥、证书内容。 */
+  getStatus() {
+    const release = this.release || {};
+    const state = this.cloudAuth.getState();
+    return {
+      ready: Boolean(release.usable),
+      enabled: Boolean(release.enabled),
+      configured: state.hasClientCertificate === true,
+      deviceId: this.metadata?.deviceId || null,
+      username: this.metadata?.username || null,
+      certificateExpiresAt: this.metadata?.certificateExpiresAt || null,
+      activated: this.metadata?.activated === true,
+      message: release.usable ? null : release.errors?.[0] || (release.missing ? "当前版本未内置云端发行配置" : "云端发行配置不可用"),
+    };
+  }
+
+  /** 退出/取消时中止进行中的兑换（迟到的响应也会因代次变化被丢弃）。 */
+  cancel() {
+    this.cancelRequested = true;
+    this.cancelToken?.cancel?.abort();
+  }
+
+  async enroll({ openingCode, password, deviceName } = {}) {
+    const code = normalizeOpeningCode(openingCode);
+    if (!code) throw fail("INVALID_REQUEST", "开通码格式不正确", { kind: "config", status: 400 });
+    if (typeof password !== "string" || password.length < 1 || password.length > 512)
+      throw fail("INVALID_REQUEST", "请输入账户密码", { kind: "config", status: 400 });
+    const name = normalizeDeviceName(deviceName);
+    if (!name) throw fail("INVALID_REQUEST", "设备名称不合法", { kind: "config", status: 400 });
+
+    if (!this.release?.usable)
+      throw fail("ENROLLMENT_UNAVAILABLE", "本机自动开通未就绪", { kind: "config", status: 503 });
+    const cloudState = this.cloudAuth.getState();
+    // 已有设备证书（含高级设置里的手工配置）时不得用发行配置覆盖；只有本模块
+    // 自己安装但尚未激活的记录允许用原码原钥续做激活。
+    if (cloudState.hasClientCertificate && !this.metadata)
+      throw fail("DEVICE_ALREADY_ENROLLED", "本机已开通，无需重复操作", { kind: "config", status: 409 });
+    if (this.metadata?.activated === true && cloudState.hasClientCertificate)
+      throw fail("DEVICE_ALREADY_ENROLLED", "本机已开通，无需重复操作", { kind: "config", status: 409 });
+
+    if (this.inflight) return this.inflight;
+    this.cancelRequested = false;
+    const entry = { epoch: this.cloudAuth.epoch, cancel: null, promise: null };
+    entry.promise = this.#runEnroll({ code, password, name, entry })
+      .catch((e) => {
+        // 文件权限/磁盘错误也收敛为固定码，绝不把本机路径或原始异常交给浏览器。
+        throw e instanceof CloudAuthError ? e : fail("STORAGE_ERROR", "本地设备配置保存失败", { kind: "config", status: 400, cause: e });
+      })
+      .finally(() => {
+      if (this.inflight === entry.promise) this.inflight = null;
+      if (this.cancelToken === entry) this.cancelToken = null;
+    });
+    this.inflight = entry.promise;
+    this.cancelToken = entry;
+    return entry.promise;
+  }
+
+  async #runEnroll({ code, password, name, entry }) {
+    if (this.cancelRequested) throw this.#stale();
+    const pending = await this.#ensurePendingKey(code, name);
+    if (this.cancelRequested || entry.epoch !== this.cloudAuth.epoch) throw this.#stale();
+
+    const signature = crypto
+      .sign("sha256", Buffer.from(canonicalEnrollmentText({ openingCode: code, publicKeyHash: pending.publicKeyHash, deviceName: name }), "utf8"), pending.privateKey)
+      .toString("base64");
+    const payload = {
+      openingCode: code,
+      publicKeyPem: pending.publicKeyPem,
+      signature,
+      deviceName: name,
+    };
+    const body = Buffer.from(JSON.stringify(payload), "utf8");
+    if (body.length > MAX_REQUEST_BYTES) throw fail("INVALID_REQUEST", "开通请求过大", { status: 400 });
+
+    const data = await this.#redeem(body, entry);
+    if (this.cancelRequested || entry.epoch !== this.cloudAuth.epoch) throw this.#stale();
+
+    const verified = verifyEnrolledCertificate({
+      chainPem: data?.certificateChainPem,
+      privateKey: pending.privateKey,
+      deviceCaPem: this.release.deviceCaPem,
+      now: this.clock(),
+    });
+    if (this.cancelRequested || entry.epoch !== this.cloudAuth.epoch) throw this.#stale();
+
+    const needsActivation = data?.needsActivation === true;
+    if (typeof data?.accountId !== "string" || !data.accountId || typeof data?.username !== "string" || !data.username)
+      throw fail("ENROLLMENT_RESPONSE_INVALID", "云端开通响应不完整");
+    if (typeof data?.deviceId !== "string" || !data.deviceId)
+      throw fail("ENROLLMENT_RESPONSE_INVALID", "云端开通响应不完整");
+    if (needsActivation && (typeof data.activationToken !== "string" || !data.activationToken))
+      throw fail("ENROLLMENT_RESPONSE_INVALID", "云端开通响应不完整");
+
+    // 先写证书/元数据（原子 rename），再改 CloudAuth 配置；任何一步失败都不会
+    // 动到旧证书文件或旧连接配置。
+    await this.#installFiles(verified, { ...data, needsActivation });
+    if (this.cancelRequested || entry.epoch !== this.cloudAuth.epoch) throw this.#stale();
+
+    const config = {
+      origin: this.release.apiOrigin,
+      caPath: this.serverCaPath,
+      certPath: this.certPath,
+      keyPath: this.keyPath,
+      p12Path: null,
+    };
+    try {
+      await this.cloudAuth.configure(config);
+    } catch (e) {
+      throw e instanceof CloudAuthError
+        ? e
+        : fail("STORAGE_ERROR", "本地云端配置保存失败", { kind: "config", status: 400, cause: e });
+    }
+
+    let session = false;
+    let sessionError = null;
+    try {
+      if (needsActivation) {
+        await this.cloudAuth.activate({ activationToken: data.activationToken, password });
+      } else {
+        await this.cloudAuth.login({ username: data.username, password });
+      }
+      session = true;
+    } catch (e) {
+      // 设备证书已安全落盘；激活/登录失败不回滚设备，交给用户重试。PENDING 账户
+      // 保留 pending 记录，用原码原钥再次兑换可获取新的激活凭证。
+      sessionError = e instanceof CloudAuthError ? e.toPublic() : fail("INTERNAL", "云端认证操作失败").toPublic();
+    }
+    await this.#saveMetadata({
+      ...this.#metadataFrom(verified, data, needsActivation),
+      activated: session || !needsActivation,
+      lastSessionError: sessionError?.code || null,
+    });
+    if (session) await fs.rm(this.pendingPath, { force: true }).catch(() => {});
+    return {
+      enrolled: true,
+      session,
+      activationPending: needsActivation && !session,
+      state: this.cloudAuth.getState(),
+      enrollment: this.getStatus(),
+      ...(sessionError ? { error: sessionError } : {}),
+    };
+  }
+
+  async #ensurePendingKey(code, deviceName) {
+    const codeHash = crypto.createHash("sha256").update(code).digest("hex");
+    let existing = null;
+    try {
+      existing = JSON.parse(await fs.readFile(this.pendingPath, "utf8"));
+    } catch (e) {
+      if (e.code !== "ENOENT") existing = null;
+    }
+    await this.#ensureDeviceDir();
+
+    if (existing && existing.codeHash === codeHash && existing.deviceName === deviceName) {
+      try {
+        const privateKey = crypto.createPrivateKey(await fs.readFile(this.keyPath));
+        const publicKeyHash = publicKeyHashOf(privateKey);
+        if (existing.publicKeyHash && existing.publicKeyHash !== publicKeyHash) throw new Error("hash mismatch");
+        return {
+          privateKey,
+          publicKeyPem: crypto.createPublicKey(privateKey).export({ type: "spki", format: "pem" }),
+          publicKeyHash,
+        };
+      } catch {
+        throw fail("DEVICE_KEY_LOST", "原设备密钥已丢失，需要重新开通", { kind: "config", status: 409 });
+      }
+    }
+
+    const { privateKey, publicKey } = await new Promise((resolve, reject) => {
+      crypto.generateKeyPair(
+        "rsa",
+        { modulusLength: 3072, publicExponent: 0x10001 },
+        (error, pub, priv) => (error ? reject(error) : resolve({ privateKey: priv, publicKey: pub })),
+      );
+    });
+    const publicKeyPem = publicKey.export({ type: "spki", format: "pem" });
+    const publicKeyHash = crypto.createHash("sha256").update(publicKey.export({ type: "spki", format: "der" })).digest("hex");
+    await this.#writeFileAtomic(this.keyPath, privateKey.export({ type: "pkcs8", format: "pem" }), 0o600);
+    await this.#writeFileAtomic(
+      this.pendingPath,
+      JSON.stringify(
+        {
+          schemaVersion: SCHEMA_VERSION,
+          codeHash,
+          deviceName,
+          publicKeyHash,
+          createdAt: new Date(this.clock()).toISOString(),
+        },
+        null,
+        2,
+      ) + "\n",
+      0o600,
+    );
+    return { privateKey, publicKeyPem, publicKeyHash };
+  }
+
+  #metadataFrom(verified, data, needsActivation) {
+    return {
+      schemaVersion: SCHEMA_VERSION,
+      accountId: data.accountId,
+      username: data.username,
+      deviceId: data.deviceId,
+      certificateExpiresAt: verified.expiresAt,
+      needsActivation: needsActivation === true,
+      installedAt: new Date(this.clock()).toISOString(),
+    };
+  }
+
+  async #installFiles(verified, data) {
+    await this.#ensureDeviceDir();
+    await this.#writeFileAtomic(this.serverCaPath, this.release.serverCaPem, 0o644);
+    await this.#writeFileAtomic(this.certPath, verified.chainPem, 0o644);
+    this.metadata = this.#metadataFrom(verified, data, data.needsActivation);
+    await this.#saveMetadata({ ...this.metadata, activated: false });
+  }
+
+  async #saveMetadata(metadata) {
+    this.metadata = metadata;
+    await this.#writeFileAtomic(this.metadataPath, JSON.stringify(metadata, null, 2) + "\n", 0o600);
+  }
+
+  async #ensureDeviceDir() {
+    await fs.mkdir(this.deviceDir, { recursive: true, mode: 0o700 });
+    await fs.chmod(this.deviceDir, 0o700);
+  }
+
+  async #writeFileAtomic(file, content, mode) {
+    const dir = path.dirname(file);
+    await fs.mkdir(dir, { recursive: true, mode: 0o700 });
+    const tmp = path.join(dir, `.${path.basename(file)}.tmp-${process.pid}-${crypto.randomBytes(4).toString("hex")}`);
+    try {
+      const handle = await fs.open(tmp, "w", mode);
+      try {
+        await handle.writeFile(content, "utf8");
+        await handle.sync();
+      } finally {
+        await handle.close();
+      }
+      await fs.chmod(tmp, mode);
+      await fs.rename(tmp, file);
+    } catch (e) {
+      await fs.rm(tmp, { force: true }).catch(() => {});
+      throw e;
+    }
+  }
+
+  #stale() {
+    return new CloudAuthError("开通请求已被更新的操作取代", { kind: "auth", code: "STALE" });
+  }
+
+  /** 兑换：只信任发行 serverCaPem，校验主机名，不重定向、不带令牌/客户端证书。 */
+  #redeem(body, entry) {
+    return new Promise((resolve, reject) => {
+      let settled = false;
+      let req = null;
+      let deadline = null;
+      const token = {
+        aborted: false,
+        abort: () => {
+          token.aborted = true;
+          try {
+            req?.destroy(new Error("enrollment canceled"));
+          } catch {
+            /* 已结束 */
+          }
+        },
+      };
+      entry.cancel = token;
+      const finish = (fn, value) => {
+        if (settled) return;
+        settled = true;
+        if (deadline) clearTimeout(deadline);
+        fn(value);
+      };
+      const error = (e) => {
+        if (e instanceof CloudAuthError) return finish(reject, e);
+        const code = String(e?.code || "");
+        if (/CERT|TLS|SSL|SELF_SIGNED|VERIFY|ALTNAME|ERR_OSSL|PEM|X509/i.test(code) || /certificate|handshake/i.test(String(e?.message || "")))
+          return finish(reject, fail("ENROLLMENT_TLS_ERROR", "云端开通服务证书或主机名校验失败", { kind: "cert", cause: e }));
+        return finish(reject, fail("ENROLLMENT_NETWORK", "无法连接云端开通服务", { kind: "network", cause: e }));
+      };
+
+      let url;
+      try {
+        url = new URL("/api/v1/device-enrollment/redeem", this.release.enrollmentOrigin);
+        if (url.protocol !== "https:") throw new Error("not https");
+      } catch (e) {
+        return error(fail("ENROLLMENT_UNAVAILABLE", "本机自动开通未就绪", { kind: "config", status: 503, cause: e }));
+      }
+
+      const options = {
+        method: "POST",
+        headers: {
+          accept: "application/json",
+          "content-type": "application/json",
+          "content-length": String(body.length),
+        },
+        ca: this.release.serverCaPem,
+        rejectUnauthorized: true,
+        minVersion: "TLSv1.2",
+        agent: false,
+        timeout: this.timeoutMs,
+      };
+      // IP 地址不发送 SNI，但 Node 仍会用 IP 做证书 SAN 校验。
+      if (!net.isIP(url.hostname)) options.servername = url.hostname;
+
+      try {
+        req = https.request(url, options, (res) => {
+          if (settled) return res.destroy();
+          const status = res.statusCode || 0;
+          const challenge = res.headers["www-authenticate"];
+          let text = "";
+          res.setEncoding("utf8");
+          res.on("data", (chunk) => {
+            if (settled) return;
+            text += chunk;
+            if (text.length > MAX_RESPONSE_BYTES) {
+              error(fail("ENROLLMENT_RESPONSE_TOO_LARGE", "云端开通响应过大", { status: 413 }));
+              res.destroy();
+            }
+          });
+          res.on("end", () => {
+            if (settled) return;
+            if (!res.complete) return error(fail("ENROLLMENT_RESPONSE_INCOMPLETE", "云端开通响应不完整", { kind: "network" }));
+            if (status >= 300 && status < 400)
+              return error(fail("ENROLLMENT_REDIRECT", "云端开通服务返回了重定向，已拒绝", { status: 400 }));
+            let parsed = null;
+            try {
+              parsed = text ? JSON.parse(text) : null;
+            } catch {
+              return error(fail("ENROLLMENT_RESPONSE_INVALID", "云端开通响应无法解析"));
+            }
+            if (status >= 200 && status < 300) {
+              if (parsed?.code !== "OK" || !parsed.data)
+                return error(fail("ENROLLMENT_RESPONSE_INVALID", "云端开通响应不完整"));
+              return finish(resolve, parsed.data);
+            }
+            const code = typeof parsed?.code === "string" ? parsed.code : `HTTP_${status}`;
+            const retryAfterMs =
+              status === 429
+                ? Math.min(MAX_RETRY_AFTER_MS, Math.max(MIN_RETRY_AFTER_MS, parseRetryAfterMs(res.headers["retry-after"], this.clock())))
+                : 0;
+            const known = new Set([
+              "INVALID_REQUEST",
+              "UNAUTHORIZED",
+              "FORBIDDEN",
+              "ACCOUNT_EXISTS",
+              "DEVICE_LIMIT",
+              "DEVICE_KEY_REUSED",
+              "ACCOUNT_ACTIVATION_PENDING",
+              "RATE_LIMITED",
+              "ENROLLMENT_UNAVAILABLE",
+            ]);
+            const mapped = known.has(code)
+              ? code
+              : status === 401
+                ? "UNAUTHORIZED"
+                : status === 403
+                  ? "FORBIDDEN"
+                  : status === 413
+                    ? "REQUEST_TOO_LARGE"
+                    : status === 429
+                      ? "RATE_LIMITED"
+                      : status === 503
+                        ? "ENROLLMENT_UNAVAILABLE"
+                        : "ENROLLMENT_FAILED";
+            error(
+              fail(mapped, "云端开通未完成", {
+                status: [400, 401, 403, 409, 413, 429, 503].includes(status) ? status : 400,
+                retryAfterMs,
+              }),
+            );
+          });
+          res.on("aborted", () => error(fail("ENROLLMENT_RESPONSE_ABORTED", "云端开通响应中断", { kind: "network" })));
+          res.on("error", (e) => error(fail("ENROLLMENT_RESPONSE_ABORTED", "云端开通响应中断", { kind: "network", cause: e })));
+          res.on("close", () => {
+            if (!settled && !res.complete) error(fail("ENROLLMENT_RESPONSE_INCOMPLETE", "云端开通响应不完整", { kind: "network" }));
+          });
+        });
+      } catch (e) {
+        return error(fail("ENROLLMENT_NETWORK", "无法连接云端开通服务", { kind: "network", cause: e }));
+      }
+      deadline = setTimeout(() => {
+        const timeout = fail("ENROLLMENT_TIMEOUT", "云端开通请求超时", { kind: "timeout" });
+        try {
+          req.destroy(timeout);
+        } catch {
+          /* 已结束 */
+        }
+        error(timeout);
+      }, Math.max(1, Number(this.timeoutMs) || 15_000));
+      req.on("timeout", () => {
+        const timeout = fail("ENROLLMENT_TIMEOUT", "云端开通请求超时", { kind: "timeout" });
+        req.destroy(timeout);
+        error(timeout);
+      });
+      req.on("error", (e) => error(e));
+      req.write(body);
+      req.end();
+    });
+  }
+}
