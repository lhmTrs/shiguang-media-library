diff --git a/server/audio-engine.mjs b/server/audio-engine.mjs
new file mode 100644
index 0000000..37be822
--- /dev/null
+++ b/server/audio-engine.mjs
@@ -0,0 +1,154 @@
+/**
+ * 音频分析引擎的安装/卸载（按需下载，基础安装包不带）。
+ *
+ * - 下载源：自有服务器（自签证书，**固定 CA**，不关闭校验）
+ * - 校验：sha256 与清单一致才解压
+ * - 安装：临时目录解压 → 原子 rename 到 <dataDir>/engines/audio/
+ * - 卸载：删目录（已存的分析结果不动）
+ */
+import fs from "node:fs/promises";
+import fssync from "node:fs";
+import path from "node:path";
+import https from "node:https";
+import crypto from "node:crypto";
+import { spawn } from "node:child_process";
+import { fileURLToPath } from "node:url";
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const CA_FILE = path.join(HERE, "audio-engine-ca.pem");
+
+export const ENGINE = {
+  version: "1.0.0",
+  url: process.env.AUDIO_ENGINE_URL || "https://112.74.109.173/downloads/audio-engine-v1-macos-arm64.tar.gz",
+  sha256: process.env.AUDIO_ENGINE_SHA256 || "61911f96c26a5cda6aae214fcde622d952729d48475754902d42905bedc7413e",
+  binary: "audio-analyze",
+};
+
+export class AudioEngine {
+  constructor(dataDir) {
+    this.dataDir = dataDir;
+    this.root = path.join(dataDir, "engines", "audio");
+    this.tmpRoot = path.join(dataDir, "engines", ".tmp");
+    this.binaryPath = path.join(this.root, ENGINE.binary);
+    this.marker = path.join(this.root, ".installed.json");
+    this.job = null; // { state, progress, bytes, total, error }
+  }
+
+  status() {
+    const installed = fssync.existsSync(this.binaryPath);
+    let info = null;
+    try {
+      info = JSON.parse(fssync.readFileSync(this.marker, "utf8"));
+    } catch {}
+    return {
+      installed,
+      version: info?.version || (installed ? "unknown" : null),
+      path: installed ? this.binaryPath : null,
+      size: installed ? safeSize(this.binaryPath) : 0,
+      job: this.job ? { ...this.job } : null,
+      expected: { version: ENGINE.version, sha256: ENGINE.sha256, url: ENGINE.url, size: 120156053 },
+    };
+  }
+
+  /** 开始安装；重复调用返回同一个 job */
+  install() {
+    if (this.job && this.job.state === "downloading") return this.status();
+    if (fssync.existsSync(this.binaryPath)) return this.status();
+    this.job = { state: "downloading", progress: 0, bytes: 0, total: 0, error: null };
+    this.#run().catch((e) => {
+      this.job = { state: "error", progress: 0, bytes: 0, total: 0, error: String(e.message || e) };
+    });
+    return this.status();
+  }
+
+  async uninstall() {
+    await fs.rm(this.root, { recursive: true, force: true });
+    this.job = null;
+    return this.status();
+  }
+
+  async #run() {
+    await fs.mkdir(this.tmpRoot, { recursive: true });
+    await fs.mkdir(path.dirname(this.root), { recursive: true });
+    const tmpDir = await fs.mkdtemp(path.join(this.tmpRoot, "dl-"));
+    const tarPath = path.join(tmpDir, "engine.tar.gz");
+    try {
+      await this.#download(tarPath);
+      this.job = { ...this.job, state: "verifying" };
+      const hash = await sha256File(tarPath);
+      if (hash !== ENGINE.sha256) throw new Error(`校验失败：期望 ${ENGINE.sha256}，实际 ${hash}`);
+      this.job = { ...this.job, state: "extracting" };
+      await runCommand("tar", ["xzf", tarPath, "-C", tmpDir]);
+      const bin = path.join(tmpDir, ENGINE.binary);
+      const st = await fs.stat(bin).catch(() => null);
+      if (!st) throw new Error("压缩包里没有 audio-analyze");
+      await fs.chmod(bin, 0o755);
+      const staged = path.join(tmpDir, "staged");
+      await fs.mkdir(staged, { recursive: true });
+      await fs.rename(bin, path.join(staged, ENGINE.binary));
+      await fs.writeFile(
+        path.join(staged, ".installed.json"),
+        JSON.stringify({ version: ENGINE.version, sha256: ENGINE.sha256, installedAt: new Date().toISOString() }),
+      );
+      await fs.rm(this.root, { recursive: true, force: true });
+      await fs.rename(staged, this.root);
+      this.job = { state: "installed", progress: 100, bytes: this.job.total, total: this.job.total, error: null };
+    } finally {
+      await fs.rm(tmpDir, { recursive: true, force: true }).catch(() => {});
+    }
+  }
+
+  #download(dest) {
+    return new Promise((resolve, reject) => {
+      const ca = fssync.readFileSync(CA_FILE);
+      const req = https.get(ENGINE.url, { ca, rejectUnauthorized: true, timeout: 120_000 }, (res) => {
+        if (res.statusCode !== 200) {
+          res.resume();
+          return reject(new Error(`下载失败：HTTP ${res.statusCode}`));
+        }
+        const total = Number(res.headers["content-length"] || 0);
+        this.job = { ...this.job, total };
+        const hash = crypto.createHash("sha256");
+        const out = fssync.createWriteStream(dest);
+        let bytes = 0;
+        res.on("data", (chunk) => {
+          bytes += chunk.length;
+          hash.update(chunk);
+          this.job = { ...this.job, bytes, progress: total ? Math.round((bytes / total) * 100) : 0 };
+        });
+        res.pipe(out);
+        out.on("finish", () => out.close(() => resolve()));
+        out.on("error", reject);
+      });
+      req.on("timeout", () => req.destroy(new Error("下载超时")));
+      req.on("error", reject);
+    });
+  }
+}
+
+function sha256File(file) {
+  return new Promise((resolve, reject) => {
+    const h = crypto.createHash("sha256");
+    fssync
+      .createReadStream(file)
+      .on("data", (c) => h.update(c))
+      .on("end", () => resolve(h.digest("hex")))
+      .on("error", reject);
+  });
+}
+
+function runCommand(cmd, args) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(cmd, args, { stdio: "ignore" });
+    child.on("error", reject);
+    child.on("exit", (code) => (code === 0 ? resolve() : reject(new Error(`${cmd} 退出码 ${code}`))));
+  });
+}
+
+function safeSize(file) {
+  try {
+    return fssync.statSync(file).size;
+  } catch {
+    return 0;
+  }
+}
diff --git a/server/audio-analysis.mjs b/server/audio-analysis.mjs
new file mode 100644
index 0000000..bb1e0b0
--- /dev/null
+++ b/server/audio-analysis.mjs
@@ -0,0 +1,168 @@
+/**
+ * 本地音频分析：调用已安装的引擎二进制，结果写 asset_audio 表。
+ *
+ * - 不联网、不上传音频；只读文件 → spawn → 解析 JSON → 存库
+ * - 串行队列（引擎吃 CPU），同一素材按 sha256 + 引擎版本缓存
+ */
+import { spawn } from "node:child_process";
+import crypto from "node:crypto";
+import fs from "node:fs";
+
+const TIMEOUT_MS = 180_000;
+
+export class AudioAnalysis {
+  constructor(lib, engine) {
+    this.lib = lib;
+    this.engine = engine;
+    this.chain = Promise.resolve();
+    this.ready = null;
+  }
+
+  #table() {
+    const idType = this.lib.mysql ? "VARCHAR(64)" : "TEXT";
+    const num = this.lib.mysql ? "DOUBLE" : "REAL";
+    return `CREATE TABLE IF NOT EXISTS asset_audio (
+      asset_id ${idType} PRIMARY KEY,
+      sha256 TEXT,
+      bpm ${num},
+      key_root TEXT,
+      key_mode TEXT,
+      loudness_rms ${num},
+      loudness_peak ${num},
+      energy_min ${num},
+      energy_max ${num},
+      duration ${num},
+      structure_json TEXT,
+      engine_version TEXT,
+      analyzed_ms INTEGER,
+      analyzed_at TEXT
+    )`;
+  }
+
+  async init() {
+    if (!this.ready) {
+      this.ready = (async () => {
+        this.lib.db.exec(this.#table());
+      })();
+    }
+    return this.ready;
+  }
+
+  get(assetId) {
+    const row = this.lib.db.prepare("SELECT * FROM asset_audio WHERE asset_id=?").get(assetId);
+    return row || null;
+  }
+
+  /** 排队分析；同一时刻只跑一个 */
+  analyze(assetId, { force = false } = {}) {
+    const run = async () => {
+      await this.init();
+      const asset = this.lib.db.prepare("SELECT id,path,name,sha256 FROM assets WHERE id=?").get(assetId);
+      if (!asset) throw Object.assign(new Error("素材不存在"), { code: "NOT_FOUND" });
+      if (!fs.existsSync(this.engine.binaryPath)) {
+        throw Object.assign(new Error("音频分析引擎未安装"), { code: "ENGINE_NOT_INSTALLED" });
+      }
+      const cached = this.get(assetId);
+      if (!force && cached && cached.engine_version === this.engine.version && cached.sha256 === asset.sha256) {
+        return { cached: true, ...cached };
+      }
+      const started = Date.now();
+      const json = await this.#runEngine(asset.path);
+      const parsed = normalize(json, asset, this.engine.version, Date.now() - started);
+      this.#save(parsed);
+      return { cached: false, ...parsed };
+    };
+    const next = this.chain.then(run, run);
+    this.chain = next.catch(() => {});
+    return next;
+  }
+
+  #runEngine(file) {
+    return new Promise((resolve, reject) => {
+      const child = spawn(this.engine.binaryPath, [file, "--json", "--brief"], {
+        stdio: ["ignore", "pipe", "pipe"],
+      });
+      let out = "";
+      let err = "";
+      const timer = setTimeout(() => {
+        child.kill("SIGKILL");
+        reject(Object.assign(new Error("音频分析超时"), { code: "TIMEOUT" }));
+      }, TIMEOUT_MS);
+      child.stdout.on("data", (c) => (out += c));
+      child.stderr.on("data", (c) => (err += c));
+      child.on("error", (e) => {
+        clearTimeout(timer);
+        reject(Object.assign(new Error(`引擎启动失败：${e.message}`), { code: "ENGINE_FAILED" }));
+      });
+      child.on("close", (code) => {
+        clearTimeout(timer);
+        if (code !== 0) {
+          return reject(Object.assign(new Error(`引擎退出码 ${code}：${err.slice(0, 200)}`), { code: "ENGINE_FAILED" }));
+        }
+        try {
+          resolve(JSON.parse(out));
+        } catch {
+          reject(Object.assign(new Error("引擎输出不是合法 JSON"), { code: "BAD_OUTPUT" }));
+        }
+      });
+    });
+  }
+
+  #save(rec) {
+    const sql = this.lib.mysql
+      ? `REPLACE INTO asset_audio (asset_id,sha256,bpm,key_root,key_mode,loudness_rms,loudness_peak,energy_min,energy_max,duration,structure_json,engine_version,analyzed_ms,analyzed_at)
+         VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)`
+      : `INSERT OR REPLACE INTO asset_audio (asset_id,sha256,bpm,key_root,key_mode,loudness_rms,loudness_peak,energy_min,energy_max,duration,structure_json,engine_version,analyzed_ms,analyzed_at)
+         VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)`;
+    this.lib.db
+      .prepare(sql)
+      .run(
+        rec.asset_id,
+        rec.sha256,
+        rec.bpm,
+        rec.key_root,
+        rec.key_mode,
+        rec.loudness_rms,
+        rec.loudness_peak,
+        rec.energy_min,
+        rec.energy_max,
+        rec.duration,
+        rec.structure_json,
+        rec.engine_version,
+        rec.analyzed_ms,
+        rec.analyzed_at,
+      );
+  }
+}
+
+function normalize(json, asset, version, ms) {
+  const key = String(json?.key?.best || "");
+  const m = key.match(/^([A-G][#b]?)\s*(minor|major)?/i);
+  const structure = json?.form?.blocks || json?.blocks || null;
+  return {
+    asset_id: asset.id,
+    sha256: asset.sha256 || null,
+    bpm: Number(json?.bpm) || 0,
+    key_root: m ? m[1] : null,
+    key_mode: m && m[2] ? m[2].toLowerCase() : null,
+    loudness_rms: Number(json?.loud?.rms ?? NaN) || null,
+    loudness_peak: Number(json?.loud?.peak ?? NaN) || null,
+    energy_min: Number(json?.energy?.min ?? NaN) || null,
+    energy_max: Number(json?.energy?.max ?? NaN) || null,
+    duration: Number(json?.dur) || null,
+    structure_json: structure ? JSON.stringify(structure) : null,
+    engine_version: version,
+    analyzed_ms: ms,
+    analyzed_at: new Date().toISOString(),
+  };
+}
+
+export function sha256Of(file) {
+  return new Promise((resolve, reject) => {
+    const h = crypto.createHash("sha256");
+    fs.createReadStream(file)
+      .on("data", (c) => h.update(c))
+      .on("end", () => resolve(h.digest("hex")))
+      .on("error", reject);
+  });
+}
