diff --git a/server/audio-job-queue.mjs b/server/audio-job-queue.mjs
new file mode 100644
index 0000000..0b2a857
--- /dev/null
+++ b/server/audio-job-queue.mjs
@@ -0,0 +1,556 @@
+/**
+ * T-LOCAL-013B：本地音频分析任务队列（内存态、单 worker）。
+ *
+ * 边界：
+ *   - 只接受内部可信 resolveAsset(assetId) 与 execute(snapshot, {signal})，不接触 HTTP 输入；
+ *   - 队列、终态保留和取消都在内存，不建表、不联网、不启动常驻轮询；
+ *   - 同 dataDir 使用本模块独立的排他目录租约（与 T12 安装锁无关），已存在一律 fail-closed，
+ *     不按 pid/时间自动回收；构造与 get 不写锁；
+ *   - 不接入 index、旧 audio-analysis、schema、前端，也不在默认启动路径实例化。
+ *
+ * 任务状态：queued → validating → snapshotting → running → succeeded；
+ * 失败为 failed；取消运行中的任务先进入 cancelling，执行 settle + 快照清理后为 cancelled。
+ */
+import fs from "node:fs/promises";
+import path from "node:path";
+import crypto from "node:crypto";
+import { AudioSnapshotError, assertSourceUnchanged, createSnapshot } from "./audio-snapshot.mjs";
+
+const DEFAULT_MAX_WAITING = 8;
+const DEFAULT_MAX_TERMINAL = 100;
+const DEFAULT_TERMINAL_TTL_MS = 24 * 60 * 60 * 1000;
+const DEFAULT_WALL_DEADLINE_MS = 180_000;
+const ACTIVE_STATES = new Set(["queued", "validating", "snapshotting", "running", "cancelling"]);
+const TERMINAL_STATES = new Set(["succeeded", "failed", "cancelled"]);
+const RESOLVER_ERROR_CODES = new Set(["ASSET_NOT_FOUND", "ASSET_BUSY"]);
+const EXECUTOR_ERROR_CODES = new Set([
+  "TIMEOUT",
+  "OUTPUT_LIMIT",
+  "INVALID_OUTPUT",
+  "ENGINE_FAILED",
+  "RESOURCE_LIMIT",
+  "CANCELLED",
+]);
+
+export const AUDIO_JOB_STATES = Object.freeze([
+  "queued",
+  "validating",
+  "snapshotting",
+  "running",
+  "succeeded",
+  "failed",
+  "cancelling",
+  "cancelled",
+]);
+
+const MESSAGES = Object.freeze({
+  INVALID_REQUEST: "请求参数无效",
+  QUEUE_DISPOSED: "队列已关闭",
+  JOB_NOT_FOUND: "任务不存在",
+  ASSET_NOT_FOUND: "素材不存在",
+  ASSET_BUSY: "素材正被其它操作占用",
+  UNSUPPORTED_ASSET: "素材类型不支持音频分析",
+  SOURCE_OFFLINE: "素材已离线",
+  SOURCE_TRASHED: "素材在废纸篓",
+  SOURCE_RETIRED: "素材已注销",
+  ROOT_RETIRED: "素材根已注销",
+  SOURCE_MISSING: "源文件不存在",
+  SOURCE_NOT_REGULAR: "源不是普通文件",
+  SOURCE_OUTSIDE_ROOT: "源超出登记根",
+  SOURCE_UNREADABLE: "源文件不可读",
+  SOURCE_CHANGED: "源文件已变化",
+  INPUT_LIMIT_EXCEEDED: "源文件超出大小限制",
+  AUDIO_QUEUE_FULL: "分析队列已满",
+  AUDIO_ENGINE_BUSY: "另一个分析队列正在使用该数据目录",
+  AUDIO_LEASE_FAILED: "分析队列租约获取失败",
+  LEASE_RELEASE_FAILED: "分析队列租约释放失败",
+  CLEANUP_FAILED: "任务清理失败",
+  RESOLVER_FAILED: "素材校验失败",
+  SNAPSHOT_FAILED: "快照失败",
+  EXECUTION_FAILED: "分析执行失败",
+  TIMEOUT: "分析超时",
+  CANCELLED: "任务已取消",
+});
+
+export class AudioQueueError extends Error {
+  constructor(code, message) {
+    super(message || MESSAGES[code] || "队列操作失败");
+    this.name = "AudioQueueError";
+    this.code = code;
+  }
+}
+
+const fail = (code) => {
+  throw new AudioQueueError(code);
+};
+
+const isActive = (job) => ACTIVE_STATES.has(job.state);
+const isTerminal = (job) => TERMINAL_STATES.has(job.state);
+
+function validToken(value) {
+  return (
+    (typeof value === "string" && value.length > 0 && value.length <= 200) ||
+    (typeof value === "number" && Number.isSafeInteger(value))
+  );
+}
+
+function validateResolved(assetId, value) {
+  if (!value || typeof value !== "object" || Array.isArray(value)) fail("ASSET_NOT_FOUND");
+  if (value.assetId !== assetId) fail("SOURCE_CHANGED");
+  if (value.kind !== "music" && value.kind !== "sfx") fail("UNSUPPORTED_ASSET");
+  for (const key of ["sourcePath", "rootPath", "rootId"]) {
+    if (typeof value[key] !== "string" || !value[key]) fail("SOURCE_CHANGED");
+  }
+  if (!path.isAbsolute(value.sourcePath) || !path.isAbsolute(value.rootPath)) fail("SOURCE_CHANGED");
+  for (const key of ["online", "trashed", "retired", "rootRetired", "busy"]) {
+    if (typeof value[key] !== "boolean") fail("SOURCE_CHANGED");
+  }
+  for (const key of ["assetGeneration", "libraryGeneration", "sourceGeneration"]) {
+    if (!validToken(value[key])) fail("SOURCE_CHANGED");
+  }
+  if (!value.online) fail("SOURCE_OFFLINE");
+  if (value.trashed) fail("SOURCE_TRASHED");
+  if (value.retired) fail("SOURCE_RETIRED");
+  if (value.rootRetired) fail("ROOT_RETIRED");
+  if (value.busy) fail("ASSET_BUSY");
+  return value;
+}
+
+function sameResolved(a, b) {
+  for (const key of [
+    "assetId",
+    "kind",
+    "sourcePath",
+    "rootPath",
+    "rootId",
+    "assetGeneration",
+    "libraryGeneration",
+    "sourceGeneration",
+    "online",
+    "trashed",
+    "retired",
+    "rootRetired",
+    "busy",
+  ]) {
+    if (a[key] !== b[key]) return false;
+  }
+  return true;
+}
+
+function mapPhaseError(error, phase) {
+  if (error instanceof AudioQueueError) return error;
+  if (error instanceof AudioSnapshotError) return new AudioQueueError(error.code, MESSAGES[error.code]);
+  if (phase === "validating") return new AudioQueueError("RESOLVER_FAILED");
+  if (phase === "snapshotting") return new AudioQueueError("SNAPSHOT_FAILED");
+  return new AudioQueueError("EXECUTION_FAILED");
+}
+
+async function readSmallJson(file) {
+  try {
+    const raw = await fs.readFile(file, "utf8");
+    if (raw.length > 4096) return null;
+    const value = JSON.parse(raw);
+    return value && typeof value === "object" ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+async function exists(p) {
+  try {
+    await fs.lstat(p);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * @param {object} options
+ * @param {string} options.dataDir 应用数据目录（租约和任务目录都在其 audio-jobs/ 下）
+ * @param {(assetId:string)=>Promise<object>|object} options.resolveAsset 可信内部解析器
+ * @param {(snapshot:object,{signal:AbortSignal})=>Promise<any>|any} options.execute 注入执行器
+ * @param {number} [options.maxWaiting=8]
+ * @param {number} [options.maxTerminal=100]
+ * @param {number} [options.terminalTtlMs]
+ * @param {number} [options.wallDeadlineMs=180000]
+ * @param {number} [options.maxSnapshotBytes]
+ * @param {object} [options.hooks] 测试注入：afterSnapshot / afterExecute / snapshotHooks
+ */
+export class AudioJobQueue {
+  #dataDir;
+  #resolveAsset;
+  #execute;
+  #maxWaiting;
+  #maxTerminal;
+  #terminalTtlMs;
+  #wallDeadlineMs;
+  #maxSnapshotBytes;
+  #hooks;
+  #jobs = new Map();
+  #waiting = [];
+  #activeJob = null;
+  #worker = null;
+  #lease = null;
+  #leaseBroken = false;
+  #disposed = false;
+  #disposePromise = null;
+  #submitChain = Promise.resolve();
+
+  constructor(options = {}) {
+    const {
+      dataDir,
+      resolveAsset,
+      execute,
+      maxWaiting = DEFAULT_MAX_WAITING,
+      maxTerminal = DEFAULT_MAX_TERMINAL,
+      terminalTtlMs = DEFAULT_TERMINAL_TTL_MS,
+      wallDeadlineMs = DEFAULT_WALL_DEADLINE_MS,
+      maxSnapshotBytes,
+      hooks = {},
+    } = options;
+    if (
+      typeof dataDir !== "string" ||
+      !dataDir ||
+      typeof resolveAsset !== "function" ||
+      typeof execute !== "function" ||
+      !Number.isSafeInteger(maxWaiting) ||
+      maxWaiting < 1 ||
+      !Number.isSafeInteger(maxTerminal) ||
+      maxTerminal < 1 ||
+      !Number.isSafeInteger(terminalTtlMs) ||
+      terminalTtlMs < 0 ||
+      !Number.isSafeInteger(wallDeadlineMs) ||
+      wallDeadlineMs < 1 ||
+      (maxSnapshotBytes !== undefined && (!Number.isSafeInteger(maxSnapshotBytes) || maxSnapshotBytes < 0))
+    ) {
+      throw new AudioQueueError("INVALID_REQUEST");
+    }
+    this.#dataDir = path.resolve(dataDir);
+    this.#resolveAsset = resolveAsset;
+    this.#execute = execute;
+    this.#maxWaiting = maxWaiting;
+    this.#maxTerminal = maxTerminal;
+    this.#terminalTtlMs = terminalTtlMs;
+    this.#wallDeadlineMs = wallDeadlineMs;
+    this.#maxSnapshotBytes = maxSnapshotBytes;
+    this.#hooks = hooks && typeof hooks === "object" ? hooks : {};
+  }
+
+  /** 只读 busy：有排队/运行任务或持有租约。供未来换库互斥判断，不写锁。 */
+  get busy() {
+    return this.#activeJob !== null || this.#waiting.length > 0 || this.#lease !== null || this.#leaseBroken;
+  }
+
+  async submit(assetId, options = {}) {
+    if (this.#disposed) fail("QUEUE_DISPOSED");
+    if (typeof assetId !== "string" || !assetId || assetId.length > 200) fail("INVALID_REQUEST");
+    if (options === null || typeof options !== "object" || Array.isArray(options)) fail("INVALID_REQUEST");
+    const keys = Object.keys(options);
+    if (keys.some((key) => key !== "force")) fail("INVALID_REQUEST");
+    if ("force" in options && typeof options.force !== "boolean") fail("INVALID_REQUEST");
+    const force = options.force === true;
+
+    return this.#serialize(async () => {
+      this.#pruneTerminal();
+      for (const job of this.#jobs.values()) {
+        if (job.assetId === assetId && isActive(job)) return this.#summary(job);
+      }
+      const resolved = validateResolved(assetId, await this.#resolve(assetId));
+      if (this.#disposed) fail("QUEUE_DISPOSED");
+      if (this.#waiting.length - (this.#activeJob ? 0 : 1) >= this.#maxWaiting) {
+        fail("AUDIO_QUEUE_FULL");
+      }
+      const job = {
+        id: crypto.randomUUID(),
+        assetId,
+        force,
+        state: "queued",
+        error: null,
+        createdAt: Date.now(),
+        startedAt: null,
+        finishedAt: null,
+        controller: null,
+        baseline: resolved,
+        snapshot: null,
+        cancelRequested: false,
+        timedOut: false,
+      };
+      this.#jobs.set(job.id, job);
+      this.#waiting.push(job);
+      this.#kick();
+      return this.#summary(job);
+    });
+  }
+
+  async get(jobId) {
+    this.#pruneTerminal();
+    if (typeof jobId !== "string" || !jobId) fail("JOB_NOT_FOUND");
+    const job = this.#jobs.get(jobId);
+    if (!job) fail("JOB_NOT_FOUND");
+    return this.#summary(job);
+  }
+
+  async cancel(jobId) {
+    this.#pruneTerminal();
+    if (typeof jobId !== "string" || !jobId) fail("JOB_NOT_FOUND");
+    const job = this.#jobs.get(jobId);
+    if (!job) fail("JOB_NOT_FOUND");
+    if (isTerminal(job)) return this.#summary(job);
+    if (job.state === "queued") {
+      const index = this.#waiting.indexOf(job);
+      if (index >= 0) this.#waiting.splice(index, 1);
+      this.#finish(job, "cancelled", null);
+      return this.#summary(job);
+    }
+    job.cancelRequested = true;
+    job.state = "cancelling";
+    job.controller?.abort();
+    return this.#summary(job);
+  }
+
+  /** 取消排队与活跃任务，await execute settle/快照清理；不自动恢复队列。 */
+  async dispose() {
+    if (this.#disposePromise) return this.#disposePromise;
+    this.#disposed = true;
+    this.#disposePromise = (async () => {
+      for (const job of [...this.#waiting]) {
+        if (job.state === "queued") this.#finish(job, "cancelled", null);
+      }
+      this.#waiting = [];
+      if (this.#activeJob) {
+        this.#activeJob.cancelRequested = true;
+        if (!isTerminal(this.#activeJob)) this.#activeJob.state = "cancelling";
+        this.#activeJob.controller?.abort();
+      }
+      await this.#worker?.catch(() => {});
+    })();
+    return this.#disposePromise;
+  }
+
+  #serialize(fn) {
+    const run = this.#submitChain.then(fn, fn);
+    this.#submitChain = run.catch(() => {});
+    return run;
+  }
+
+  #summary(job) {
+    return {
+      id: job.id,
+      assetId: job.assetId,
+      state: job.state,
+      queuePosition: job.state === "queued" ? this.#waiting.indexOf(job) + 1 : null,
+      error: job.error ? { code: job.error.code, message: job.error.message } : null,
+      createdAt: job.createdAt,
+      startedAt: job.startedAt,
+      finishedAt: job.finishedAt,
+    };
+  }
+
+  async #resolve(assetId) {
+    let value;
+    try {
+      value = await this.#resolveAsset(assetId);
+    } catch (error) {
+      if (error && RESOLVER_ERROR_CODES.has(error.code)) {
+        throw new AudioQueueError(error.code, MESSAGES[error.code]);
+      }
+      throw new AudioQueueError("RESOLVER_FAILED");
+    }
+    return validateResolved(assetId, value);
+  }
+
+  #kick() {
+    if (this.#worker || this.#disposed || this.#leaseBroken) return;
+    this.#worker = this.#drain()
+      .catch(() => {})
+      .finally(() => {
+        this.#worker = null;
+        if (!this.#disposed && !this.#leaseBroken && this.#waiting.length > 0) this.#kick();
+      });
+  }
+
+  async #drain() {
+    while (!this.#disposed && this.#waiting.length > 0 && !this.#leaseBroken) {
+      const job = this.#waiting.shift();
+      if (!job || job.state !== "queued") continue;
+      await this.#runJob(job);
+    }
+  }
+
+  async #runJob(job) {
+    this.#activeJob = job;
+    job.startedAt = Date.now();
+    // 从等待队列取出后立即脱离 queued，避免“已开始但取消仍按排队处理”的窗口。
+    job.state = "validating";
+    job.controller = new AbortController();
+    const { signal } = job.controller;
+    const timer = setTimeout(() => {
+      if (isTerminal(job)) return;
+      job.timedOut = true;
+      job.state = "cancelling";
+      job.controller?.abort();
+    }, this.#wallDeadlineMs);
+    let outcome = null;
+    let leaseReleased = false;
+    try {
+      await this.#acquireLease();
+      if (signal.aborted) fail("CANCELLED");
+      let current = await this.#resolve(job.assetId);
+      if (!sameResolved(current, job.baseline)) fail("SOURCE_CHANGED");
+      job.baseline = current;
+      if (signal.aborted) fail("CANCELLED");
+
+      job.state = "snapshotting";
+      job.snapshot = await createSnapshot({
+        dataDir: this.#dataDir,
+        rootPath: current.rootPath,
+        sourcePath: current.sourcePath,
+        maxBytes: this.#maxSnapshotBytes,
+        signal,
+        jobId: job.id,
+        hooks: this.#hooks.snapshotHooks,
+      });
+      if (this.#hooks.afterSnapshot) await this.#hooks.afterSnapshot({ job: this.#summary(job), snapshot: job.snapshot });
+
+      current = await this.#resolve(job.assetId);
+      if (!sameResolved(current, job.baseline)) fail("SOURCE_CHANGED");
+      job.baseline = current;
+      if (signal.aborted) fail("CANCELLED");
+
+      job.state = "running";
+      await this.#execute(job.snapshot, { signal });
+      if (this.#hooks.afterExecute) await this.#hooks.afterExecute({ job: this.#summary(job), snapshot: job.snapshot });
+
+      if (job.cancelRequested || signal.aborted) {
+        outcome = job.timedOut
+          ? new AudioQueueError("TIMEOUT")
+          : new AudioQueueError("CANCELLED");
+      } else {
+        current = await this.#resolve(job.assetId);
+        if (!sameResolved(current, job.baseline)) fail("SOURCE_CHANGED");
+        await assertSourceUnchanged(job.snapshot);
+        if (job.cancelRequested || signal.aborted) {
+          outcome = job.timedOut ? new AudioQueueError("TIMEOUT") : new AudioQueueError("CANCELLED");
+        }
+      }
+    } catch (error) {
+      if (job.timedOut) outcome = new AudioQueueError("TIMEOUT");
+      else if (job.cancelRequested || signal.aborted) outcome = new AudioQueueError("CANCELLED");
+      else if (job.state === "running" && EXECUTOR_ERROR_CODES.has(error?.code)) {
+        outcome = new AudioQueueError(error.code, MESSAGES[error.code]);
+      } else outcome = mapPhaseError(error, job.state === "cancelling" ? "running" : job.state);
+    }
+
+    // 清理先于租约释放和终态公布；清理失败 fail-closed，保留租约与 busy。
+    let cleanupError = null;
+    if (job.snapshot) {
+      try {
+        await job.snapshot.cleanup();
+      } catch {
+        cleanupError = new AudioQueueError("CLEANUP_FAILED");
+      }
+    }
+    if (cleanupError) {
+      this.#leaseBroken = true;
+      outcome = cleanupError;
+    } else {
+      try {
+        await this.#releaseLease();
+        leaseReleased = true;
+      } catch {
+        this.#leaseBroken = true;
+        outcome = new AudioQueueError("LEASE_RELEASE_FAILED");
+      }
+    }
+
+    clearTimeout(timer);
+    if (outcome && outcome.code === "CANCELLED") {
+      this.#finish(job, "cancelled", null);
+    } else if (outcome) {
+      this.#finish(job, "failed", outcome);
+    } else if (job.timedOut) {
+      this.#finish(job, "failed", new AudioQueueError("TIMEOUT"));
+    } else if (job.cancelRequested || signal.aborted) {
+      this.#finish(job, "cancelled", null);
+    } else {
+      this.#finish(job, "succeeded", null);
+    }
+    this.#activeJob = null;
+    job.controller = null;
+    this.#pruneTerminal();
+    if (!leaseReleased && !this.#leaseBroken) this.#lease = null;
+  }
+
+  #finish(job, state, error) {
+    job.state = state;
+    job.error = error ? { code: error.code, message: error.message } : null;
+    job.finishedAt = Date.now();
+    job.controller = null;
+  }
+
+  #pruneTerminal() {
+    const now = Date.now();
+    const terminal = [...this.#jobs.values()].filter(isTerminal);
+    const expired = new Set(
+      terminal.filter((job) => job.finishedAt !== null && now - job.finishedAt > this.#terminalTtlMs),
+    );
+    const alive = terminal
+      .filter((job) => !expired.has(job))
+      .sort((a, b) => b.finishedAt - a.finishedAt);
+    for (const job of alive.slice(this.#maxTerminal)) expired.add(job);
+    for (const job of expired) this.#jobs.delete(job.id);
+  }
+
+  async #acquireLease() {
+    const base = path.join(this.#dataDir, "audio-jobs");
+    const lockRoot = path.join(base, ".queue-lease");
+    const token = crypto.randomBytes(16).toString("hex");
+    try {
+      await fs.mkdir(base, { recursive: true, mode: 0o700 });
+      await fs.chmod(base, 0o700).catch(() => {});
+      await fs.mkdir(lockRoot, { mode: 0o700 });
+    } catch (error) {
+      if (["EEXIST", "ENOTEMPTY", "ENOTDIR", "EISDIR"].includes(error.code)) {
+        // 已存在锁（含无 owner/身份不可验证/旧进程已死）一律 BUSY；不自动回收。
+        throw new AudioQueueError("AUDIO_ENGINE_BUSY");
+      }
+      throw new AudioQueueError("AUDIO_LEASE_FAILED");
+    }
+    const owner = {
+      pid: process.pid,
+      token,
+      purpose: "audio-job-queue",
+      startedAt: new Date().toISOString(),
+    };
+    try {
+      await fs.writeFile(path.join(lockRoot, "owner.json"), JSON.stringify(owner), {
+        mode: 0o600,
+        flag: "wx",
+      });
+    } catch {
+      // 只回收本进程刚 mkdir、仍无 owner 的空锁；其它情况保留。
+      const marker = await exists(path.join(lockRoot, "owner.json"));
+      if (!marker) await fs.rmdir(lockRoot).catch(() => {});
+      throw new AudioQueueError("AUDIO_LEASE_FAILED");
+    }
+    this.#lease = { token };
+  }
+
+  async #releaseLease() {
+    if (!this.#lease) return;
+    const base = path.join(this.#dataDir, "audio-jobs");
+    const lockRoot = path.join(base, ".queue-lease");
+    const owner = await readSmallJson(path.join(lockRoot, "owner.json"));
+    if (!owner || owner.token !== this.#lease.token || owner.purpose !== "audio-job-queue") {
+      throw new AudioQueueError("LEASE_RELEASE_FAILED");
+    }
+    try {
+      await fs.rm(lockRoot, { recursive: true, force: true });
+    } catch {
+      throw new AudioQueueError("LEASE_RELEASE_FAILED");
+    }
+    if (await exists(lockRoot)) throw new AudioQueueError("LEASE_RELEASE_FAILED");
+    this.#lease = null;
+  }
+}
diff --git a/server/audio-snapshot.mjs b/server/audio-snapshot.mjs
new file mode 100644
index 0000000..3a60e8f
--- /dev/null
+++ b/server/audio-snapshot.mjs
@@ -0,0 +1,358 @@
+/**
+ * T-LOCAL-013B：登记根内源文件的有界私有快照。
+ *
+ * 只接受内部可信 resolver 产物（assetId/rootPath/sourcePath 等），不接触 HTTP 输入。
+ * 设计目标：
+ *   - realpath 后复用 fs-identity.within 做登记根边界判断；
+ *   - 只接受普通文件，拒绝目录/FIFO/设备/最终符号链接与逃逸链接；
+ *   - 打开时 O_NOFOLLOW|O_NONBLOCK，打开后 fstat 复核身份，防止“验证后被换成 FIFO”挂死；
+ *   - 单个 64KiB 读循环同时完成复制与 SHA256，不 readFile 整文件；
+ *   - 前后核对 dev/ino/size/mtime/ctime，复制中增长/修改/替换都报 SOURCE_CHANGED；
+ *   - 任务目录 0700、文件 0600 且排他创建；清理只删带本任务 token 标记的目录。
+ *
+ * 本模块不启动进程、不联网、不读数据库、不写日志。
+ */
+import fs from "node:fs/promises";
+import { constants } from "node:fs";
+import path from "node:path";
+import crypto from "node:crypto";
+import { within } from "./fs-identity.mjs";
+
+const CHUNK_BYTES = 64 * 1024;
+const DEFAULT_MAX_BYTES = 256 * 1024 * 1024;
+const MARKER = ".owner.json";
+const SNAPSHOT_FILE = "source.bin";
+
+export const SNAPSHOT_CODES = Object.freeze({
+  SOURCE_MISSING: "SOURCE_MISSING",
+  SOURCE_NOT_REGULAR: "SOURCE_NOT_REGULAR",
+  SOURCE_OUTSIDE_ROOT: "SOURCE_OUTSIDE_ROOT",
+  SOURCE_UNREADABLE: "SOURCE_UNREADABLE",
+  SOURCE_CHANGED: "SOURCE_CHANGED",
+  INPUT_LIMIT_EXCEEDED: "INPUT_LIMIT_EXCEEDED",
+  CANCELLED: "CANCELLED",
+  SNAPSHOT_FAILED: "SNAPSHOT_FAILED",
+  CLEANUP_FAILED: "CLEANUP_FAILED",
+  INVALID_REQUEST: "INVALID_REQUEST",
+});
+
+const MESSAGES = Object.freeze({
+  SOURCE_MISSING: "源文件不存在",
+  SOURCE_NOT_REGULAR: "源不是普通文件",
+  SOURCE_OUTSIDE_ROOT: "源超出登记根",
+  SOURCE_UNREADABLE: "源文件不可读",
+  SOURCE_CHANGED: "源文件已变化",
+  INPUT_LIMIT_EXCEEDED: "源文件超出大小限制",
+  CANCELLED: "快照已取消",
+  SNAPSHOT_FAILED: "快照失败",
+  CLEANUP_FAILED: "快照清理失败",
+  INVALID_REQUEST: "快照参数无效",
+});
+
+export class AudioSnapshotError extends Error {
+  constructor(code, message) {
+    super(message || MESSAGES[code] || "快照失败");
+    this.name = "AudioSnapshotError";
+    this.code = code;
+  }
+}
+
+const fail = (code) => {
+  throw new AudioSnapshotError(code);
+};
+
+const isAborted = (signal) => Boolean(signal?.aborted);
+const checkAbort = (signal) => {
+  if (isAborted(signal)) fail("CANCELLED");
+};
+
+function mapFsError(error) {
+  if (error instanceof AudioSnapshotError) return error;
+  switch (error?.code) {
+    case "ENOENT":
+    case "ENOTDIR":
+      return new AudioSnapshotError("SOURCE_MISSING");
+    case "ELOOP":
+    case "EISDIR":
+    case "ENXIO":
+      return new AudioSnapshotError("SOURCE_NOT_REGULAR");
+    case "EACCES":
+    case "EPERM":
+      return new AudioSnapshotError("SOURCE_UNREADABLE");
+    default:
+      return new AudioSnapshotError("SNAPSHOT_FAILED");
+  }
+}
+
+function closeTo(a, b) {
+  return typeof a === "number" && typeof b === "number" && a === b;
+}
+
+/** dev/ino/size/mtime/ctime 同步身份；ctime 用于识别“内容被改但 mtime 被还原”。 */
+function sameIdentity(a, b) {
+  return (
+    a &&
+    b &&
+    a.dev === b.dev &&
+    a.ino === b.ino &&
+    a.size === b.size &&
+    closeTo(a.mtimeMs, b.mtimeMs) &&
+    closeTo(a.ctimeMs, b.ctimeMs)
+  );
+}
+
+function identityOf(stat) {
+  return {
+    dev: stat.dev,
+    ino: stat.ino,
+    size: stat.size,
+    mtimeMs: stat.mtimeMs,
+    ctimeMs: stat.ctimeMs,
+  };
+}
+
+async function readMarker(dir) {
+  try {
+    const raw = await fs.readFile(path.join(dir, MARKER), { encoding: "utf8", flag: "r" });
+    if (raw.length > 4096) return null;
+    const value = JSON.parse(raw);
+    return value && typeof value === "object" ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+/** 只删除本进程创建、token 仍匹配、且位于私有 audio-jobs 根内的任务目录。 */
+async function removeOwnedDir(base, dir, token) {
+  const marker = await readMarker(dir);
+  if (!marker || marker.token !== token) fail("CLEANUP_FAILED");
+  if (!within(base, dir) || dir === base) fail("CLEANUP_FAILED");
+  try {
+    await fs.rm(dir, { recursive: true, force: true });
+  } catch {
+    fail("CLEANUP_FAILED");
+  }
+  if (await exists(dir)) fail("CLEANUP_FAILED");
+}
+
+async function exists(p) {
+  try {
+    await fs.lstat(p);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * 创建一份快照。
+ *
+ * @param {object} options
+ * @param {string} options.dataDir 应用数据目录；快照落在 <dataDir>/audio-jobs/ 下
+ * @param {string} options.rootPath 已登记根
+ * @param {string} options.sourcePath 源文件
+ * @param {number} [options.maxBytes] 实际复制字节上限，默认 256MiB
+ * @param {AbortSignal} [options.signal]
+ * @param {string} [options.jobId]
+ * @param {object} [options.hooks] 仅测试使用的注入点：beforeOpen / afterChunk
+ */
+export async function createSnapshot(options = {}) {
+  const {
+    dataDir,
+    rootPath,
+    sourcePath,
+    maxBytes = DEFAULT_MAX_BYTES,
+    signal,
+    jobId = "snapshot",
+    hooks = {},
+  } = options;
+  if (
+    typeof dataDir !== "string" ||
+    !dataDir ||
+    typeof rootPath !== "string" ||
+    !rootPath ||
+    typeof sourcePath !== "string" ||
+    !sourcePath ||
+    !Number.isSafeInteger(maxBytes) ||
+    maxBytes < 0 ||
+    typeof jobId !== "string" ||
+    !jobId
+  ) {
+    fail("INVALID_REQUEST");
+  }
+  checkAbort(signal);
+
+  let rootReal;
+  let sourceReal;
+  let before;
+  try {
+    rootReal = await fs.realpath(rootPath);
+    const rootStat = await fs.lstat(rootReal);
+    if (!rootStat.isDirectory()) fail("SOURCE_OUTSIDE_ROOT");
+    sourceReal = await fs.realpath(sourcePath);
+  } catch (error) {
+    throw mapFsError(error);
+  }
+  if (!within(rootReal, sourceReal)) fail("SOURCE_OUTSIDE_ROOT");
+  if (sourceReal === rootReal) fail("SOURCE_NOT_REGULAR");
+
+  try {
+    // 最终组件必须是普通文件，不接受符号链接（即使指向根内）；父级符号链接仅在其
+    // realpath 仍落在登记根内时允许。
+    const lst = await fs.lstat(sourcePath);
+    if (lst.isSymbolicLink()) fail("SOURCE_NOT_REGULAR");
+    if (!lst.isFile()) fail("SOURCE_NOT_REGULAR");
+    before = identityOf(lst);
+  } catch (error) {
+    throw mapFsError(error);
+  }
+  if (before.size > maxBytes) fail("INPUT_LIMIT_EXCEEDED");
+
+  if (typeof hooks.beforeOpen === "function") await hooks.beforeOpen({ sourcePath, sourceReal });
+
+  let handle;
+  try {
+    handle = await fs.open(
+      sourceReal,
+      constants.O_RDONLY | (constants.O_NOFOLLOW || 0) | (constants.O_NONBLOCK || 0),
+    );
+  } catch (error) {
+    throw mapFsError(error);
+  }
+
+  let opened;
+  try {
+    opened = await handle.stat();
+    if (!opened.isFile()) fail("SOURCE_NOT_REGULAR");
+    if (!sameIdentity(before, identityOf(opened))) fail("SOURCE_CHANGED");
+  } catch (error) {
+    await handle.close().catch(() => {});
+    throw mapFsError(error);
+  }
+
+  const base = path.join(dataDir, "audio-jobs");
+  const token = crypto.randomBytes(16).toString("hex");
+  const dir = path.join(base, `job-${process.pid}-${token.slice(0, 16)}`);
+  let created = false;
+  let markerWritten = false;
+  let out;
+  try {
+    await fs.mkdir(base, { recursive: true, mode: 0o700 });
+    await fs.chmod(base, 0o700).catch(() => {});
+    await fs.mkdir(dir, { mode: 0o700 });
+    created = true;
+    await fs.writeFile(
+      path.join(dir, MARKER),
+      JSON.stringify({ token, jobId, pid: process.pid, createdAt: new Date().toISOString() }),
+      { mode: 0o600, flag: "wx" },
+    );
+    markerWritten = true;
+    const filePath = path.join(dir, SNAPSHOT_FILE);
+    out = await fs.open(filePath, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL, 0o600);
+
+    const hash = crypto.createHash("sha256");
+    const buffer = Buffer.allocUnsafe(CHUNK_BYTES);
+    let bytes = 0;
+    let chunks = 0;
+    for (;;) {
+      checkAbort(signal);
+      const { bytesRead } = await handle.read(buffer, 0, buffer.length, null);
+      if (bytesRead === 0) break;
+      bytes += bytesRead;
+      if (bytes > maxBytes) fail("INPUT_LIMIT_EXCEEDED");
+      // 复制中增长：早于后置 fstat 给出确定错误，避免继续多读。
+      if (bytes > opened.size) fail("SOURCE_CHANGED");
+      hash.update(buffer.subarray(0, bytesRead));
+      await out.write(buffer, 0, bytesRead);
+      chunks += 1;
+      if (typeof hooks.afterChunk === "function") {
+        await hooks.afterChunk({ bytes, chunks, dir, filePath, sourcePath });
+      }
+    }
+    checkAbort(signal);
+
+    let after;
+    try {
+      after = await handle.stat();
+    } catch {
+      fail("SOURCE_CHANGED");
+    }
+    if (!sameIdentity(opened, identityOf(after))) fail("SOURCE_CHANGED");
+    if (bytes !== opened.size) fail("SOURCE_CHANGED");
+
+    // 路径仍指向打开时的同一对象；realpath 也不能在复制期间换到别处。
+    let now;
+    try {
+      now = await fs.lstat(sourceReal);
+      const realAgain = await fs.realpath(sourcePath);
+      if (realAgain !== sourceReal) fail("SOURCE_CHANGED");
+      if (!within(rootReal, realAgain)) fail("SOURCE_OUTSIDE_ROOT");
+    } catch (error) {
+      throw mapFsError(error);
+    }
+    if (now.isSymbolicLink() || !now.isFile()) fail("SOURCE_CHANGED");
+    if (now.dev !== opened.dev || now.ino !== opened.ino) fail("SOURCE_CHANGED");
+    if (!sameIdentity(identityOf(opened), identityOf(now))) fail("SOURCE_CHANGED");
+
+    const digest = hash.digest("hex");
+    const snapshot = {
+      filePath,
+      dir,
+      token,
+      sha256: digest,
+      bytes,
+      chunks,
+      sourcePath,
+      sourceReal,
+      rootReal,
+      rootPath,
+      jobId,
+      source: identityOf(opened),
+      cleaned: false,
+      cleanup: null,
+    };
+    snapshot.cleanup = async () => {
+      if (snapshot.cleaned) return;
+      await removeOwnedDir(base, dir, token);
+      snapshot.cleaned = true;
+    };
+    return snapshot;
+  } catch (error) {
+    try {
+      await out?.close();
+    } catch {
+      /* close 失败由目录清理兜底 */
+    }
+    out = null;
+    let cleanupError = null;
+    if (created) {
+      try {
+        if (markerWritten) await removeOwnedDir(base, dir, token);
+        else await fs.rmdir(dir).catch(() => {});
+      } catch {
+        cleanupError = true;
+      }
+    }
+    if (cleanupError) throw new AudioSnapshotError("CLEANUP_FAILED");
+    throw mapFsError(error);
+  } finally {
+    await out?.close().catch(() => {});
+    await handle.close().catch(() => {});
+  }
+}
+
+/** 运行结束后核对源文件仍是快照时的同一对象；返回 true 或抛固定错误。 */
+export async function assertSourceUnchanged(snapshot) {
+  if (!snapshot || typeof snapshot !== "object") fail("SOURCE_CHANGED");
+  try {
+    const realAgain = await fs.realpath(snapshot.sourcePath);
+    if (realAgain !== snapshot.sourceReal) fail("SOURCE_CHANGED");
+    if (!within(snapshot.rootReal, realAgain)) fail("SOURCE_OUTSIDE_ROOT");
+    const now = await fs.lstat(snapshot.sourceReal);
+    if (now.isSymbolicLink() || !now.isFile()) fail("SOURCE_CHANGED");
+    if (!sameIdentity(snapshot.source, identityOf(now))) fail("SOURCE_CHANGED");
+    return true;
+  } catch (error) {
+    throw mapFsError(error);
+  }
+}
diff --git a/tests/audio-job-queue.test.mjs b/tests/audio-job-queue.test.mjs
new file mode 100644
index 0000000..d14bfe7
--- /dev/null
+++ b/tests/audio-job-queue.test.mjs
@@ -0,0 +1,591 @@
+/**
+ * T-LOCAL-013B：内存任务队列/租约/取消/终态保留的隔离测试。
+ *
+ * 使用临时目录、64KiB 合成文件与合成 executor；不启动真实引擎、不读真实素材/数据库、不联网。
+ */
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import crypto from "node:crypto";
+import { AudioJobQueue } from "../server/audio-job-queue.mjs";
+
+const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+}
+
+async function tempBase(t) {
+  const dir = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), "shiguang-queue-")));
+  t.after(() => fs.rm(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+async function waitFor(fn, label, timeoutMs = 3000) {
+  const started = Date.now();
+  for (;;) {
+    const value = await fn();
+    if (value) return value;
+    if (Date.now() - started > timeoutMs) throw new Error(`等待超时：${label}`);
+    await delay(5);
+  }
+}
+
+async function waitState(queue, id, state) {
+  return waitFor(async () => {
+    try {
+      const job = await queue.get(id);
+      return job.state === state ? job : null;
+    } catch {
+      return null;
+    }
+  }, `${id} -> ${state}`);
+}
+
+async function expectQueueCode(promise, code) {
+  await assert.rejects(promise, (error) => {
+    assert.equal(error.code, code, String(error));
+    return true;
+  });
+}
+
+async function harness(t, options = {}) {
+  const base = await tempBase(t);
+  const root = path.join(base, "media");
+  const dataDir = path.join(base, "data");
+  await fs.mkdir(root, { recursive: true });
+  const assets = new Map();
+  const stats = {
+    resolves: 0,
+    active: 0,
+    maxConcurrent: 0,
+    executions: [],
+  };
+  let executor = options.executor || (async () => ({ ok: true }));
+  const hooks = options.hooks || {};
+
+  const resolveAsset = async (assetId) => {
+    stats.resolves += 1;
+    const asset = assets.get(assetId);
+    return asset ? { ...asset } : null;
+  };
+  const execute = async (snapshot, context) => {
+    stats.active += 1;
+    stats.maxConcurrent = Math.max(stats.maxConcurrent, stats.active);
+    const entry = {
+      assetId: snapshot.jobId,
+      snapshotDir: snapshot.dir,
+      filePath: snapshot.filePath,
+      sha256: snapshot.sha256,
+      startedAt: Date.now(),
+      endedAt: null,
+    };
+    stats.executions.push(entry);
+    try {
+      return await executor(snapshot, context);
+    } finally {
+      stats.active -= 1;
+      entry.endedAt = Date.now();
+    }
+  };
+
+  const queue = new AudioJobQueue({
+    dataDir,
+    resolveAsset,
+    execute,
+    wallDeadlineMs: options.wallDeadlineMs ?? 1000,
+    maxSnapshotBytes: 1024 * 1024,
+    maxWaiting: options.maxWaiting ?? 8,
+    maxTerminal: options.maxTerminal ?? 100,
+    terminalTtlMs: options.terminalTtlMs ?? 24 * 60 * 60 * 1000,
+    hooks,
+  });
+  t.after(async () => {
+    await queue.dispose().catch(() => {});
+  });
+
+  async function addAsset(id, overrides = {}) {
+    const sourcePath = path.join(root, `${id}.bin`);
+    if (!(await fs.lstat(sourcePath).catch(() => null))) {
+      await fs.writeFile(sourcePath, crypto.randomBytes(96 * 1024));
+    }
+    const asset = {
+      assetId: id,
+      kind: "music",
+      sourcePath,
+      rootPath: root,
+      rootId: "root-1",
+      online: true,
+      trashed: false,
+      retired: false,
+      rootRetired: false,
+      busy: false,
+      assetGeneration: 1,
+      libraryGeneration: 1,
+      sourceGeneration: 1,
+      ...overrides,
+    };
+    assets.set(id, asset);
+    return asset;
+  }
+
+  const lockPath = path.join(dataDir, "audio-jobs", ".queue-lease");
+  const jobsPath = path.join(dataDir, "audio-jobs");
+  return {
+    base,
+    root,
+    dataDir,
+    queue,
+    assets,
+    stats,
+    hooks,
+    lockPath,
+    jobsPath,
+    addAsset,
+    setExecutor(fn) {
+      executor = fn;
+    },
+  };
+}
+
+async function jobDirs(jobsPath) {
+  const entries = await fs.readdir(jobsPath).catch(() => []);
+  return entries.filter((name) => name.startsWith("job-"));
+}
+
+test("严格输入：未知字段/非 boolean force/错误 assetId 拒绝，未知 job 固定 JOB_NOT_FOUND", async (t) => {
+  const h = await harness(t);
+  await h.addAsset("a");
+  await expectQueueCode(h.queue.submit(""), "INVALID_REQUEST");
+  await expectQueueCode(h.queue.submit(42), "INVALID_REQUEST");
+  await expectQueueCode(h.queue.submit("a", null), "INVALID_REQUEST");
+  await expectQueueCode(h.queue.submit("a", { force: "true" }), "INVALID_REQUEST");
+  await expectQueueCode(h.queue.submit("a", { model: "x" }), "INVALID_REQUEST");
+  await expectQueueCode(h.queue.get("missing"), "JOB_NOT_FOUND");
+  await expectQueueCode(h.queue.get(""), "JOB_NOT_FOUND");
+  await expectQueueCode(h.queue.cancel("missing"), "JOB_NOT_FOUND");
+  assert.equal(await fs.lstat(h.lockPath).catch(() => null), null, "构造/get 不写锁");
+  assert.equal(h.queue.busy, false);
+});
+
+test("单 worker、8 等待上限、同 asset/force 合并、完成后重新解析并生成新任务", async (t) => {
+  const gate = deferred();
+  const h = await harness(t, {
+    executor: async () => {
+      await gate.promise;
+      return { ok: true };
+    },
+  });
+  const ids = ["a", "b", "c", "d", "e", "f", "g", "h", "i"];
+  for (const id of ids) await h.addAsset(id);
+  await h.addAsset("extra");
+  const jobs = [];
+  for (const id of ids) jobs.push(await h.queue.submit(id));
+  await waitState(h.queue, jobs[0].id, "running");
+  await expectQueueCode(h.queue.submit("extra"), "AUDIO_QUEUE_FULL");
+  const merged = await h.queue.submit("a", { force: true });
+  assert.equal(merged.id, jobs[0].id, "非终态同 asset 合并，force 也不重复");
+  assert.equal(jobs[0].queuePosition, null);
+
+  gate.resolve();
+  for (const job of jobs) await waitState(h.queue, job.id, "succeeded");
+  assert.equal(h.stats.maxConcurrent, 1, "最多一个 worker 同时执行");
+  assert.deepEqual(
+    h.stats.executions.map((entry) => entry.assetId),
+    jobs.map((job) => job.id),
+    "按提交顺序执行",
+  );
+  assert.equal((await h.queue.get(jobs[0].id)).state, "succeeded");
+
+  const before = h.stats.resolves;
+  const next = await h.queue.submit("a");
+  assert.notEqual(next.id, jobs[0].id, "完成后新提交必须新任务");
+  await waitState(h.queue, next.id, "succeeded");
+  assert.ok(h.stats.resolves - before >= 2, "重新解析素材");
+  assert.equal((await jobDirs(h.jobsPath)).length, 0, "任务目录均已清理");
+  assert.equal(await fs.lstat(h.lockPath).catch(() => null), null, "租约已释放");
+});
+
+test("排队取消立即移除；终态 cancel 不改变结果", async (t) => {
+  const gate = deferred();
+  const h = await harness(t, {
+    executor: async () => {
+      await gate.promise;
+      return { ok: true };
+    },
+  });
+  for (const id of ["a", "b", "c"]) await h.addAsset(id);
+  const a = await h.queue.submit("a");
+  await waitState(h.queue, a.id, "running");
+  const b = await h.queue.submit("b");
+  const c = await h.queue.submit("c");
+  assert.equal(b.queuePosition, 1);
+  const cancelled = await h.queue.cancel(b.id);
+  assert.equal(cancelled.state, "cancelled");
+  assert.equal((await h.queue.get(c.id)).queuePosition, 1);
+  gate.resolve();
+  await waitState(h.queue, a.id, "succeeded");
+  await waitState(h.queue, c.id, "succeeded");
+  assert.equal((await h.queue.get(b.id)).state, "cancelled");
+  assert.deepEqual(
+    h.stats.executions.map((entry) => entry.assetId),
+    [a.id, c.id],
+    "取消的排队任务没有执行",
+  );
+  assert.equal((await h.queue.cancel(a.id)).state, "succeeded", "成功后 cancel 幂等且不改结果");
+});
+
+test("运行中取消：cancelling 等待 execute settle + 快照清理后才 cancelled，然后才下一项", async (t) => {
+  let first = true;
