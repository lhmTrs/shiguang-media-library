+  onNotice,
+}: {
+  auth: CloudAuthController;
+  onLogin: () => void;
+  onNotice: (message: string) => void;
+}) {
+  const [open, setOpen] = useState(false);
+  const root = useRef<HTMLDivElement>(null);
+  const loggedIn = auth.view?.state === "logged-in" && !!auth.view.username;
+  const name = loggedIn
+    ? auth.view?.displayName || auth.view?.username || ""
+    : "";
+
+  useEffect(() => {
+    if (!open) return;
+    const outside = (event: PointerEvent) => {
+      if (!root.current?.contains(event.target as Node)) setOpen(false);
+    };
+    const escape = (event: KeyboardEvent) => {
+      if (event.key === "Escape") {
+        setOpen(false);
+        root.current?.querySelector("button")?.focus();
+      }
+    };
+    document.addEventListener("pointerdown", outside);
+    document.addEventListener("keydown", escape);
+    return () => {
+      document.removeEventListener("pointerdown", outside);
+      document.removeEventListener("keydown", escape);
+    };
+  }, [open]);
+
+  useEffect(() => {
+    if (!loggedIn) setOpen(false);
+  }, [loggedIn]);
+
+  function toggle() {
+    if (!loggedIn) {
+      onLogin();
+      return;
+    }
+    const next = !open;
+    setOpen(next);
+    // 打开菜单时顺带校准一次状态；迟到的旧响应会被当前代次丢弃。
+    if (next) void auth.readStatus().catch(() => undefined);
+  }
+
+  async function logout() {
+    setOpen(false);
+    try {
+      const result = await auth.logout();
+      onNotice(
+        result.cloudRevoked
+          ? "已退出，云端会话已撤销"
+          : `本地已退出；云端撤销未确认（${describeFailure(result.error, "login")}）`,
+      );
+    } catch (error) {
+      onNotice(`退出未完成：${describeFailure(error as CloudLastError, "login")}`);
+      void auth.readStatus().catch(() => undefined);
+    }
+  }
+
+  return (
+    <div className="account-entry" ref={root}>
+      <button
+        type="button"
+        className={"account-button" + (loggedIn ? " signed-in" : "")}
+        aria-label={loggedIn ? `账户：${name}` : "登录"}
+        aria-haspopup={loggedIn ? "menu" : undefined}
+        aria-expanded={loggedIn ? open : undefined}
+        disabled={auth.busy === "logout"}
+        onClick={toggle}
+      >
+        {loggedIn ? <UserRound size={17} /> : <LogIn size={17} />}
+        <span className="account-label">{loggedIn ? name : "登录"}</span>
+        {loggedIn && <ChevronDown size={14} className="account-chevron" />}
+        {auth.busy === "logout" && <LoaderCircle size={14} className="spin" />}
+      </button>
+      {open && loggedIn && (
+        <div className="account-menu" role="menu" aria-label="账户菜单">
+          <div className="account-menu-head">
+            <strong>{name}</strong>
+            <small>@{auth.view?.username}</small>
+            <span className={"account-state " + (auth.view?.state === "logged-in" ? "ready" : "")}>
+              {auth.view ? stateLabel(auth.view) : "读取中"}
+            </span>
+          </div>
+          <button type="button" role="menuitem" onClick={() => void logout()} disabled={auth.busy === "logout"}>
+            <LogOut size={15} />
+            退出登录
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
+
+export function CloudLoginPage({
+  auth,
+  onBack,
+  onAdvanced,
+}: {
+  auth: CloudAuthController;
+  onBack: () => void;
+  onAdvanced: () => void;
+}) {
+  const [mode, setMode] = useState<"login" | "activate">("login");
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [activationToken, setActivationToken] = useState("");
+  const [activationPassword, setActivationPassword] = useState("");
+  const [error, setError] = useState("");
+  const lock = useRef(false);
+
+  const configured = !!auth.view?.configured;
+  const disabled = !!auth.busy || lock.current;
+  const sessionReady = auth.view?.state === "logged-in";
+
+  // 已有有效会话时直接回主界面，避免登录页循环。
+  useEffect(() => {
+    if (sessionReady) onBack();
+  }, [sessionReady, onBack]);
+
+  async function submitLogin(event: FormEvent) {
+    event.preventDefault();
+    if (lock.current || auth.busy) return;
+    if (!configured) {
+      setError("云端服务尚未就绪，请先在高级云端设置中完成连接配置");
+      return;
+    }
+    if (!username.trim() || !password) {
+      setError("请输入用户名和密码");
+      return;
+    }
+    lock.current = true;
+    setError("");
+    const submitted = password;
+    // 密码提交即离开表单内存，不等待响应；失败后需重新输入。
+    setPassword("");
+    try {
+      await auth.login(username.trim(), submitted);
+    } catch (failure) {
+      setError(describeFailure(failure as CloudLastError, "login"));
+    } finally {
+      lock.current = false;
+    }
+  }
+
+  async function submitActivation(event: FormEvent) {
+    event.preventDefault();
+    if (lock.current || auth.busy) return;
+    if (!configured) {
+      setError("云端服务尚未就绪，请先在高级云端设置中完成连接配置");
+      return;
+    }
+    if (!activationToken || !activationPassword) {
+      setError("请输入激活凭证和新密码");
+      return;
+    }
+    lock.current = true;
+    setError("");
+    const submittedToken = activationToken;
+    const submittedPassword = activationPassword;
+    setActivationToken("");
+    setActivationPassword("");
+    try {
+      await auth.activate(submittedToken, submittedPassword);
+    } catch (failure) {
+      setError(describeFailure(failure as CloudLastError, "login"));
+    } finally {
+      lock.current = false;
+    }
+  }
+
+  function retryStatus() {
+    setError("");
+    void auth.readStatus().catch((failure) => setError(describeFailure(failure as CloudLastError, "login")));
+  }
+
+  return (
+    <div className="login-page">
+      <header className="login-header">
+        <div className="login-brand">
+          <span className="brand-icon">
+            <ShieldCheck size={23} />
+          </span>
+          <div className="brand-name">
+            <strong>拾光</strong>
+            <span>云端账户</span>
+          </div>
+        </div>
+        <button type="button" className="plain login-back" onClick={onBack} disabled={!!auth.busy}>
+          <ArrowLeft size={16} />
+          返回素材库
+        </button>
+      </header>
+      <main className="login-main">
+        <section className="login-card" aria-labelledby="login-title">
+          <div className="login-heading">
+            <h1 id="login-title">{mode === "login" ? "登录云端账户" : "激活本机设备"}</h1>
+            <p>
+              {mode === "login"
+                ? "登录只用于云端协作；不登录也能继续管理本地素材。"
+                : "激活凭证只用于当前设备证书，激活成功后会自动登录。"}
+            </p>
+          </div>
+
+          {auth.loading && (
+            <p className="login-status" role="status">
+              <LoaderCircle size={15} className="spin" />
+              正在检查云端服务…
+            </p>
+          )}
+          {auth.loadError && !auth.loading && (
+            <div className="login-warning" role="alert">
+              <span>{auth.loadError}</span>
+              <button type="button" className="text-button" onClick={retryStatus}>
+                <RefreshCw size={13} />
+                重试
+              </button>
+            </div>
+          )}
+
+          {auth.view && !configured && (
+            <div className="login-not-ready" role="status">
+              <CloudOff size={18} />
+              <div>
+                <strong>云端服务尚未就绪</strong>
+                <p>
+                  当前版本还没有内置可用的云端地址与设备证书。你仍可返回素材库继续管理本地素材；管理员可在“设置与缓存 →
+                  高级云端设置”中检查连接配置。
+                </p>
+              </div>
+            </div>
+          )}
+
+          {sessionReady ? (
+            <p className="login-status" role="status">
+              <LoaderCircle size={15} className="spin" />
+              已登录，正在返回素材库…
+            </p>
+          ) : mode === "login" ? (
+            <form className="login-form" onSubmit={submitLogin} aria-label="云端账户登录">
+              <label className="field">
+                用户名
+                <input
+                  aria-label="用户名"
+                  autoComplete="username"
+                  spellCheck={false}
+                  value={username}
+                  disabled={disabled}
+                  onChange={(event) => setUsername(event.target.value)}
+                />
+              </label>
+              <label className="field">
+                密码
+                <input
+                  aria-label="密码"
+                  type="password"
+                  autoComplete="current-password"
+                  value={password}
+                  disabled={disabled}
+                  onChange={(event) => setPassword(event.target.value)}
+                />
+              </label>
+              <button type="submit" className="primary login-submit" disabled={disabled || !configured}>
+                {auth.busy === "login" ? <LoaderCircle size={16} className="spin" /> : <LogIn size={16} />}
+                {auth.busy === "login" ? "登录中…" : "登录"}
+              </button>
+            </form>
+          ) : (
+            <form className="login-form" onSubmit={submitActivation} aria-label="设备激活">
+              <label className="field">
+                激活凭证
+                <input
+                  aria-label="激活凭证"
+                  autoComplete="off"
+                  spellCheck={false}
+                  value={activationToken}
+                  disabled={disabled}
+                  onChange={(event) => setActivationToken(event.target.value)}
+                />
+              </label>
+              <label className="field">
+                设置密码（至少 12 个字符）
+                <input
+                  aria-label="激活设置密码"
+                  type="password"
+                  autoComplete="new-password"
+                  value={activationPassword}
+                  disabled={disabled}
+                  onChange={(event) => setActivationPassword(event.target.value)}
+                />
+              </label>
+              <button type="submit" className="primary login-submit" disabled={disabled || !configured}>
+                {auth.busy === "activate" ? <LoaderCircle size={16} className="spin" /> : <KeyRound size={16} />}
+                {auth.busy === "activate" ? "激活中…" : "激活并登录"}
+              </button>
+            </form>
+          )}
+
+          {error && (
+            <p className="login-error" role="alert">
+              {error}
+            </p>
+          )}
+          <div className="login-secondary">
+            {mode === "login" ? (
+              <button
+                type="button"
+                className="text-button"
+                disabled={disabled || !configured}
+                onClick={() => {
+                  setMode("activate");
+                  setError("");
+                }}
+              >
+                <KeyRound size={14} />
+                首次在本机使用？激活设备
+              </button>
+            ) : (
+              <button
+                type="button"
+                className="text-button"
+                disabled={disabled}
+                onClick={() => {
+                  setMode("login");
+                  setError("");
+                }}
+              >
+                <LogIn size={14} />
+                返回账号登录
+              </button>
+            )}
+            <button type="button" className="text-button" disabled={!!auth.busy} onClick={onAdvanced}>
+              <ShieldCheck size={14} />
+              高级云端设置
+            </button>
+          </div>
+
+          <p className="login-footnote">
+            浏览器不会保存密码、激活码或云端令牌；本机文件与素材默认不上传。
+          </p>
+        </section>
+      </main>
+    </div>
+  );
+}
