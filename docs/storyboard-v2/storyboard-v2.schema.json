  "required": [
    "格式",
    "格式版本",
    "文档编号",
    "内容修订",
    "项目名称",
    "版本说明",
    "类型",
    "画幅",
    "帧率",
    "形式",
    "故事核心",
    "时间轴说明",
    "目标时长秒",
    "总时长秒",
    "镜头总数",
