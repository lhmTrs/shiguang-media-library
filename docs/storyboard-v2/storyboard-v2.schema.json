{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiguang.local/schemas/storyboard-2.0.0.json",
  "title": "拾光分镜交换格式 2.0.0",
  "description": "设计规格；中文导演分镜、项目资产与采用快照。项目归属、跨对象引用、时间轴和快照摘要必须另做语义校验。未知字段保留。",
  "type": "object",
  "properties": {
    "格式": {
      "const": "shiguang-storyboard"
    },
    "格式版本": {
      "const": "2.0.0"
    },
    "文档编号": {
      "$ref": "#/$defs/uuid"
    },
    "内容修订": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "项目名称": {
      "$ref": "#/$defs/name"
    },
    "版本说明": {
      "type": "string",
      "maxLength": 100000
    },
    "类型": {
      "type": "string",
      "maxLength": 100000
    },
    "画幅": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "帧率": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "形式": {
      "type": "string",
      "maxLength": 100000
    },
    "故事核心": {
      "type": "string",
      "maxLength": 100000
    },
    "时间轴说明": {
      "type": "string",
      "maxLength": 100000
    },
    "目标时长秒": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.001,
      "maximum": 9007199254740,
      "multipleOf": 0.001
    },
    "总时长秒": {
      "$ref": "#/$defs/seconds"
    },
    "镜头总数": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "输出范围": {
      "$ref": "#/$defs/scope"
    },
    "素材清单": {
      "$ref": "#/$defs/catalog"
    },
    "全片设定": {
      "$ref": "#/$defs/anyObject"
    },
    "场景": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sequence"
      },
      "maxItems": 1000
    },
    "连续性与时长锁定": {
      "$ref": "#/$defs/anyObject"
    },
    "应用数据": {
      "$ref": "#/$defs/appData"
    },
    "扩展": {
      "$ref": "#/$defs/anyObject"
    }
