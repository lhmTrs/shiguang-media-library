        "结束镜号": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "类型",
        "全片起始秒"
      ],
      "additionalProperties": true
    },
    "look": {
      "type": "object",
      "properties": {
